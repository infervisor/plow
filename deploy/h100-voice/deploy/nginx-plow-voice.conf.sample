# nginx TLS front for plow-voice (plowrt has no TLS of its own).
# Install as /etc/nginx/conf.d/plow-voice.conf, set server_name and the certificate paths, keep
# plow-voice on BIND=127.0.0.1, then: nginx -t && systemctl reload nginx
#
# What matters for this API:
#  * WebSocket upgrade for /v1/audio/transcriptions/stream and /v1/realtime.
#  * No buffering, so SSE (stream=true) and chunked streaming TTS reach the client as produced.
#  * Long read timeouts: streams and WebSocket sessions outlive nginx's 60 s default.
#  * Body size: plowrt accepts up to 64 MiB of JSON and 4 MiB of transcription upload.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream plow_voice {
    server 127.0.0.1:8000;
    keepalive 64;
}

server {
    listen 443 ssl;
    http2 off;   # WebSocket upgrade needs HTTP/1.1 between client and nginx
    server_name voice.example.com;

    ssl_certificate     /etc/ssl/certs/voice.example.com.pem;
    ssl_certificate_key /etc/ssl/private/voice.example.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 64m;

    location / {
        proxy_pass http://plow_voice;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Optional: keep /metrics off the public listener.
    location = /metrics { allow 127.0.0.1; deny all; proxy_pass http://plow_voice; }
}

server {
    listen 80;
    server_name voice.example.com;
    return 301 https://$host$request_uri;
}
