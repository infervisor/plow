# plow-voice configuration: KEY=VALUE lines, read by deploy/plow-voice.sh (no shell evaluation).
# Installed as /etc/plow-voice/plow-voice.conf (mode 0640, root:<service group)); edit, then
#   sudo systemctl restart plow-voice

# Model set: a file in deploy/profiles/ (docs/DEPLOY.md "Profiles"). Every model of the profile
# is loaded at startup and stays resident: no model swapping.
PROFILE=voice-core

# Listen address. 127.0.0.1 = local only (put the TLS reverse proxy on the same host);
# 0.0.0.0 = every interface (set API_KEYS, and terminate TLS in front of it).
BIND=127.0.0.1
PORT=8000

# Comma-separated API keys. When set, every route except /health and /healthz needs
# `Authorization: Bearer <key>` or `x-api-key: <key>` (401 otherwise). Empty = no auth.
API_KEYS=

# Logging: RUST_LOG-style level (error, warn, info, debug). Empty LOG_FILE = stdout (the journal
# under systemd); a path appends there instead.
LOG_LEVEL=info
LOG_FILE=

# SIGTERM drain: live requests get this long to finish before exit (ms).
DRAIN_TIMEOUT_MS=30000
# A transcription that takes longer is cancelled and answered 504 (ms).
ASR_REQUEST_TIMEOUT_MS=120000
# How long a finished X-Session-Id request's state is retained for the session's next turn (ms).
SESSION_TTL_MS=60000
# Concurrent HTTP/WebSocket connections per listener.
HTTP_MAX_CONNECTIONS=4096

# Advanced (leave empty unless needed):
# GPU selection (an index or UUID), e.g. CUDA_VISIBLE_DEVICES=1 on a multi-GPU host.
CUDA_VISIBLE_DEVICES=
# Path to libcuda.so.1 when the driver library is not on the default loader path.
LIBCUDA=
# Override the profile's model list / per-model context bounds (space-separated / name=ctx,...).
MODELS=
LIVE_CTX=
# Extra plowrt serve flags, space-separated.
EXTRA_ARGS=
