[Unit]
Description=plowrt ASR server (qwen3-asr with Silero VAD; HTTP + streaming on :8000)
After=network-online.target
Wants=network-online.target

[Service]
User=ssm-user
WorkingDirectory=/opt/plow-asr
Environment=LD_LIBRARY_PATH=/opt/plow-asr/lib
# PLOW_API_KEYS=k1,k2 turns on bearer auth for every route except /health and /healthz.
EnvironmentFile=-/etc/plow-asr.env
ExecStart=/opt/plow-asr/bin/plowrt serve --bind 0.0.0.0 --port 8000 \
  --assets /opt/plow-asr/models/qwen3-asr \
  --asr-vad-packet /opt/plow-asr/models/silero-vad/silero_vad.pkt
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=45
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
