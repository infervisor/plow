  "recorder_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport re\n\nroot = Path(__file__).parent\nsha = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()\npins = json.loads((root / 'campaign-source.json').read_text())\nassert sha(root / 'plowrt') == pins['runtime_sha256']\nassert sha(root / 'assets-on/model.pkt') == pins['packet_sha256']\nassert sha(root / 'campaign.sh') == pins['campaign_sha256']\nfor name, expected in pins['objects'].items():\n    assert sha(root / 'overlay' / name) == expected, name\nresult = json.loads((root / 'serve-on.json').read_text())\nquality = json.loads((root / 'quality-on.json').read_text())\nassert (result['completed'], result['failed']) == (100, 0)\nassert len(quality['cells']) == 18 and all(c['passed'] for c in quality['cells'])\nbaseline_path = Path('runtime/bench/amd/mla_fp8_kv/mi300x-decode-tiers.json')\nbaseline = json.loads(baseline_path.read_text())\nassert result['input_lens'] == baseline['request_lengths']['input']\nassert result['output_lens'] == baseline['request_lengths']['output']\nassert result['total_input_tokens'] == 7018227\nassert result['total_output_tokens'] == 71149\nlog = (root / 'server-on.log').read_text()\nassert re.findall(r'routed experts packed; expert pointer tables filled layers=75 gib=\"([0-9.]+)\"', log) == ['84.40'] * 8\nassert re.findall(r'allocated reusable AITER MoE workspace bytes=(\\d+)', log) == ['153231616'] * 8\nassert 'dstep_log: false' in log\nmetrics = {k: v for k, v in result.items() if not isinstance(v, (list, dict))}\nh200 = dict(duration=259.98, output_throughput=273.67, mean_ttft_ms=1431.42,\n            median_ttft_ms=904.93, p99_ttft_ms=5235.23, mean_tpot_ms=65.92,\n            median_tpot_ms=77.82, p99_tpot_ms=85.77, mean_itl_ms=82.17,\n            median_itl_ms=76.31, p99_itl_ms=344.13)\nprior = baseline['arms']['off']['metrics']\ncomparison_fields = ('output_throughput', 'mean_ttft_ms', 'mean_tpot_ms', 'p99_tpot_ms', 'median_itl_ms')\nrecord = dict(\n    schema='plow.glm.resident-full100.v1', artifact_root=str(root), date='2026-09-10',\n    hardware=dict(gpu='MI300X', count=8, arch='gfx942'), campaign_source=pins,\n    workload=dict(num_prompts=100, random_input_len=70000, random_output_len=700,\n                  random_range_ratio=0.14, max_concurrency=20, seed=0, speculative_decoding=False),\n    metrics=metrics, input_lens=result['input_lens'], output_lens=result['output_lens'], quality=quality,\n    h200_user_reference=h200,\n    ratio_to_h200={k: result[k] / v for k, v in h200.items()},\n    historical_baseline=dict(path=str(baseline_path), sha256=sha(baseline_path), arm='off', metrics=prior),\n    change_percent_vs_historical={k: 100 * (result[k] / prior[k] - 1) for k in comparison_fields},\n    sha256={p.name: sha(p) for p in (root / 'serve-on.json', root / 'quality-on.json', root / 'server-on.log', root / 'bench-on.log', Path(__file__))},\n    recorder_source=Path(__file__).read_text(),\n    limitations=[\n        'One run; no repeatability estimate.',\n        'Historical comparison changes multiple kernels and packet routes; it is not a matched single-change experiment.',\n        'H200 GPU count, TP configuration, server launch options and cache state are unknown. Its supplied reference includes speculative decoding; this Plow run does not.',\n        'Retrieval checks do not establish broad model quality equivalence.',\n        'Frozen runtime and objects from the resident qualification; later repository changes are not included.',\n    ])\nPath('runtime/bench/amd/moe_aiter/mi300x-resident-full100.json').write_text(json.dumps(record, indent=2) + '\\n')\nprint(json.dumps(dict(metrics=metrics, ratio_to_h200=record['ratio_to_h200'], change_percent_vs_historical=record['change_percent_vs_historical']), indent=2))\n",
