  "parser_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport re\n\n\ndef parse(text):\n    records = []\n    rung = None\n    seen = set()\n    current = None\n    for line in text.splitlines():\n        match = re.search(r'decode ladder rung rung=(\\d+) occupied=(\\d+)', line)\n        if match:\n            rung = int(match[1])\n            seen.add(rung)\n        match = re.match(r'DECODE STEP BREAKDOWN\\s+n=(\\d+) tokens\\s+mean=([0-9.]+) \u00b5s/token', line)\n        if match:\n            current = dict(ticks=int(match[1]), mean_us=float(match[2]),\n                           rung_at_dump=rung, rungs_since_previous_dump=sorted(seen), phases={})\n            continue\n        if current is None:\n            continue\n        match = re.match(r'^(.*?)\\s+([0-9.]+)\\s+([0-9.]+)\\s+([0-9.]+)%$', line)\n        if match:\n            current['phases'][match[1]] = dict(mean_us=float(match[2]), calls_per_tick=float(match[3]), percent=float(match[4]))\n        match = re.match(r'^UNATTRIBUTED .*?\\s+([0-9.]+)\\s+([0-9.]+)%$', line)\n        if match:\n            current['unattributed_us'] = float(match[1])\n            records.append(current)\n            current = None\n            seen = {rung} if rung is not None else set()\n    return records\n\n\ndef summarize(records):\n    ticks = sum(r['ticks'] for r in records)\n    if ticks == 0:\n        return None\n    phases = set.intersection(*(set(r['phases']) for r in records))\n    return dict(windows=len(records), ticks=ticks,\n                mean_us=sum(r['ticks'] * r['mean_us'] for r in records) / ticks,\n                phases_us={p: sum(r['ticks'] * r['phases'][p]['mean_us'] for r in records) / ticks for p in sorted(phases)})\n\n\nif __name__ == '__main__':\n    root = Path(__file__).parent\n    log = root / 'server-diagnostic.log'\n    records = parse(log.read_text())\n    assert records, 'no host phase windows'\n    for row in records:\n        assert any('enqueue' in p for p in row['phases'])\n        assert any('drain' in p for p in row['phases'])\n    stable = [r for r in records if r['rungs_since_previous_dump'] == [20]]\n    result_path = root / 'serve-diagnostic.json'\n    serving = json.loads(result_path.read_text())\n    assert (serving['completed'], serving['failed']) == (40, 0)\n    sha = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()\n    report = dict(\n        schema='plow.glm.resident-host-phases.v1', artifact_root=str(root), date='2026-09-10',\n        campaign_source=json.loads((root / 'campaign-source.json').read_text()),\n        windows=records, all_windows=summarize(records), stable_batch20=summarize(stable),\n        stable_definition='No reported decode-rung change away from 20 since the preceding phase dump; includes any scheduler idle or prefill interruptions in that window.',\n        serving={k: v for k, v in serving.items() if not isinstance(v, (list, dict))},\n        sha256={p.name: sha(p) for p in (log, result_path, root / 'bench-diagnostic.log', Path(__file__))},\n        parser_source=Path(__file__).read_text(),\n        limitations=[\n            'Host wall-clock phase windows, not a GPU critical-path trace.',\n            'Enqueue can include queue backpressure and overlaps GPU execution. Drain measures the residual host wait after submission.',\n            'Do not equate the printed HOST TOTAL with removable CPU computation or drain with all GPU time.',\n            'Server log spans client warmup and main benchmark; windows are not attributed to individual requests. stable_batch20 excludes reported rung transitions.',\n            'Counter double buffering is enabled; inactive-bank rearming follows submission and overlaps GPU execution.',\n            'Short-input diagnostic with instrumentation; not a production throughput comparison or the H200 workload.',\n        ],\n    )\n    Path('runtime/bench/amd/moe_aiter/mi300x-resident-host-phases.json').write_text(json.dumps(report, indent=2) + '\\n')\n    print(json.dumps({'all_windows': report['all_windows'], 'stable_batch20': report['stable_batch20']}, indent=2))\n",
