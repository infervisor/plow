  "reproduction_sources": {
    "emit.sh": "#!/usr/bin/env bash\nset -euo pipefail\nroot=/tmp/tp-glm53-select-b20\ncp target/release/plowrt \"$root/plowrt\"\ncp target/release/plowc \"$root/plowc\"\nexport PLOW_UNISEG=0 PLOW_GLM_DSA_PF_SPAN=3 PLOW_MLA_PF_V2=1 PLOW_MLA_PF_AITER=1\nexport PLOW_VERIFY_BIN=/app/plow/lean-plow/.lake/build/bin/plow_verify\nfor arm in off on; do\n enabled=false\n if [ \"$arm\" = on ]; then enabled=true; fi\n \"$root/plowc\" --hf-dir /workspace/models/GLM-5.3-plow-lite --gpu MI300X --num-gpus 8 --batch 1,4,8,16,20 --emit-decode-batch-ladder 1,2,4,8,16,20 --glm-fp8-kv=true --seq 512,2048,8192 --max-ctx 81920 --arch gfx942 --emit devblob --replay-knobs /tmp/tp-glm53-lt-native/assets/build.json --glm-gemm-lt=true --emit-packed-prefill=false --glm-select-local=\"$enabled\" --glm-place-pf=false --glm-moe-flat-decode=false --glm-gemm-lt-decode=true --glm-fold-lt=false --out \"$root/assets-$arm\" > \"$root/emit-$arm.log\" 2>&1\ndone\ncmp \"$root/assets-off/model.pkt\" /tmp/tp-glm53-b20-gemm/assets-on/model.pkt\n",
    "campaign.sh": "#!/usr/bin/env bash\nset -euo pipefail\nexport PLOW_MLA_PF_V2=1 PLOW_MLA_PF_AITER=1 PLOW_PF_CHUNK=8192 PLOW_PF_INTERLEAVE=0\nexport LD_LIBRARY_PATH=\"$ROCM_PATH/lib:${LD_LIBRARY_PATH:-}\"\nroot=/tmp/tp-glm53-select-b20\nexport PLOW_HSACO_LOWRUNG=\"\"\nif [ \"$#\" = 0 ]; then set -- on off; fi\nfor arm in \"$@\"; do\n    export PLOW_HSACO=/tmp/tp-glm53-fp8-b20/overlay\n    \"$root/plowrt\" serve --assets \"$root/assets-$arm\" --port 18992 > \"$root/server-$arm.log\" 2>&1 &\n    server=$!\n    trap 'kill -TERM \"$server\" 2>/dev/null || true; wait \"$server\" 2>/dev/null || true' EXIT\n    ready=0\n    for attempt in $(seq 1 180); do\n        if curl -fsS http://127.0.0.1:18992/v1/models > \"$root/models-$arm.json\" 2>/dev/null; then ready=1; break; fi\n        kill -0 \"$server\" || exit 1\n        sleep 1\n    done\n    [ \"$ready\" = 1 ]\n    python3 runtime/bench/amd/mla_sparse_aiter/quality.py http://127.0.0.1:18992 \"local-select-b20-$arm\" \"$root/quality-$arm.json\" --concurrency 20 > \"$root/quality-$arm.log\" 2>&1\n    env VLLM_ROCM_LIB=/opt/rocm/core-7.14/lib /app/plow/build-gemma31/vllm-python -m vllm.entrypoints.cli.main bench serve --backend vllm --host 127.0.0.1 --port 18992 --model glm-5.3-plow-lite --tokenizer zai-org/GLM-5.3 --trust-remote-code --dataset-name random --num-prompts 20 --random-input-len 70000 --random-output-len 700 --random-range-ratio 0.14 --max-concurrency 20 --save-result --save-detailed --result-dir \"$root\" --result-filename \"serve-$arm.json\" > \"$root/bench-$arm.log\" 2>&1\n    kill -TERM \"$server\"\n    wait \"$server\" || [ \"$?\" = 143 ]\n    trap - EXIT\ndone\n",
    "check_packets.py": "from pathlib import Path\nimport hashlib\nimport json\nimport subprocess\n\nroot = Path(__file__).parent\nsha = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()\nprograms = {}\nrecords = {}\nfor arm in ('off', 'on'):\n    packet = root / f'assets-{arm}' / 'model.pkt'\n    out = subprocess.check_output([str(root / 'plowrt'), 'disasm', str(packet), '--format', 'json', '--no-analysis'], text=True)\n    (root / f'disasm-{arm}.json').write_text(out)\n    report = json.loads(out[out.index('{'):])\n    programs[arm] = {p['t']: p for p in report['programs']}\n    records[arm] = {'packet_sha256': sha(packet), 'programs': []}\n    for p in report['programs']:\n        selectors = [d for d in p['insts'] if d['op_name'] == 'IndexSelect']\n        local = [d for d in selectors if d['raw']['i'][4] == 1]\n        if arm == 'on' and p['t'] in (2, 4, 8, 16, 20):\n            assert len(local) == len(selectors) == 21, (p['t'], len(local), len(selectors))\n            assert all(d['blocks'] == p['t'] for d in local)\n        else:\n            assert not local\n        records[arm]['programs'].append({'rows': p['t'], 'selectors': len(selectors), 'local_selectors': len(local)})\nassert (root / 'assets-off/model.pkt').read_bytes() == Path('/tmp/tp-glm53-b20-gemm/assets-on/model.pkt').read_bytes()\nfor rows, p in programs['off'].items():\n    if rows not in (2, 4, 8, 16, 20):\n        assert p == programs['on'][rows], rows\nrecords.update(runtime_sha256=sha(root/'plowrt'), compiler_sha256=sha(root/'plowc'), off_packet_byte_identical=True,\n               unchanged_program_rows=[r for r in programs['off'] if r not in (2,4,8,16,20)])\n(root / 'packet-check.json').write_text(json.dumps(records, indent=2) + '\\n')\nprint(json.dumps(records, indent=2))\n"
