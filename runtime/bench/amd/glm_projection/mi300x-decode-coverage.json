    "check_packets.py": "from pathlib import Path\nimport collections\nimport hashlib\nimport json\nimport subprocess\n\nroot = Path(__file__).parent\nsha = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()\nprograms = {}\nrecords = {}\nfor arm in ('off', 'on'):\n    packet = root / f'assets-{arm}' / 'model.pkt'\n    out = subprocess.check_output([str(root / 'plowrt'), 'disasm', str(packet), '--format', 'json', '--no-analysis'], text=True)\n    (root / f'disasm-{arm}.json').write_text(out)\n    report = json.loads(out[out.index('{'):])\n    programs[arm] = {p['t']: p for p in report['programs']}\n    records[arm] = {'packet_sha256': sha(packet), 'programs': []}\n    for p in report['programs']:\n        native = [d for d in p['insts'] if d['op_name'] == 'GemmLtPf' and d['raw']['i'][3] == 1]\n        gemv = [d for d in p['insts'] if d['op_name'] == 'Gemv']\n        if p['t'] in (16, 20):\n            assert len(native) == (633 if arm == 'on' else 312), (arm, p['t'], len(native))\n            assert len(gemv) == (199 if arm == 'on' else 520), (arm, p['t'], len(gemv))\n            if arm == 'on':\n                shapes = collections.Counter(tuple(d['raw']['i'][1:3]) for d in native)\n                assert shapes[(256, 6144)] == 225\n                assert shapes[(6144, 256)] == 75\n                assert shapes[(4096, 2048)] == 99\n        else:\n            assert not native\n        records[arm]['programs'].append({'rows': p['t'], 'native_decode_gemms': len(native), 'gemvs': len(gemv)})\nassert (root / 'assets-old-disabled/model.pkt').read_bytes() == (root / 'assets-new-disabled/model.pkt').read_bytes()\nfor rows, p in programs['off'].items():\n    if rows not in (16, 20):\n        assert p == programs['on'][rows], rows\nrecords.update(runtime_sha256=sha(root/'plowrt'), compiler_sha256=sha(root/'plowc'),\n               disabled_packet_byte_identical=True,\n               disabled_packet_sha256=sha(root/'assets-new-disabled/model.pkt'),\n               unchanged_program_rows=[r for r in programs['off'] if r not in (16,20)])\n(root / 'packet-check.json').write_text(json.dumps(records, indent=2) + '\\n')\nprint(json.dumps(records, indent=2))\n"
