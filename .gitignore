# Local-only plans / research scratchpad for coding agents
plans/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
target/
plow-out/
build/.claude/worktrees/
runtime/ubench/build/

# Claude Code agent worktrees + session state (lives at .claude/, not build/.claude/)
.claude/
build/
build-*/
*.log
__pycache__block-assets/
__pycache__

# ISOLATED CARGO TARGET DIRS. One per concurrent agent or feature set, so a
# rebuild of the shared `target/` under different features cannot break another
# run's binaries — `--features hsa` is the usual reason, and a shared target dir
# is what once made `plowc` fingerprint a different worktree's source tree.
# Globbed rather than enumerated: this list had four entries and three more
# arrived untracked in a single session.
target-*/
ba_agt/
ba_ctl/
ba_hier/
ba_hier2/
ba_keeprel/
ba_l2/
ba_l2hier/
ba_main/
ba_sc1/
ba_sc1g/
# every cmake hsaco build dir from the HIER2/SC1 campaign; objects, not source
ba_*/
gpucore.*.gpu

# committed-by-accident artifacts (binaries/profiles live outside git)
cuda-keyring_*.deb
plow_profile.sqlite

# GPU binary build outputs — never check in (bundles link them from build dirs)
*.cubin
*.hsaco

# plowc/plowrt emitted serve-asset bundles for this campaign (model.pkt, weights.json, cubins)
assets-run/
venv-sglang/
.venv-sglang/
sglang-pkgs/

# Keep removed performance reports and campaign directories local.
/perf-data/**/*.json
/perf-data/**/*.jsonl
/perf-data/**/*.md
/perf-data/gemma3-12b-h100/
/perf-data/gemma4-12b-h100-data/
/runtime/bench/amd/dsa_pf_tp/*.md
/runtime/bench/amd/dsa_pf_tp/*.json
/runtime/bench/amd/dsa_pf_tp/*.jsonl
/runtime/bench/amd/dsa_select_parallel/*.md
/runtime/bench/amd/dsa_select_parallel/*.json
/runtime/bench/amd/dsa_select_parallel/*.jsonl

# Sibling checkouts used for cross-branch comparison
.worktrees/
/runtime/bench/amd/moe_aiter/mi300x-resident-trace.json
/runtime/bench/amd/moe_aiter/mi300x-resident-prefill.json

# Campaign RESULTS stay local: raw measurement JSON/CSV under the bench and perf-data trees
# and per-probe write-ups are removed on every upstream merge (see
# docs/bringup/tp-bringup-upstream-review-log.md). Inputs the code reads are tracked
# explicitly: glm_fold_tail/gemm-selected.json (amd_mla_fold.rs), tuning/**/*.jsonl (tunedb),
# runtime/ubench/mfma_shape_results/summary.csv (collect_occ1.sh).
/runtime/bench/**/*.json
/runtime/bench/**/*.jsonl
/runtime/bench/**/*.csv
!/runtime/bench/amd/glm_fold_tail/gemm-selected.json
!/runtime/bench/amd/mla_materialized_prefill/vllm_capture.example.json
/perf-data/**/*.csv
/runtime/nvidia/experiments/*.md
!/runtime/nvidia/experiments/README.md
