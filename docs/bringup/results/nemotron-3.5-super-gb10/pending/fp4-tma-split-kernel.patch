+/// Smaller chunks keep the cp.async feed: at <= 1024 rows an expert holds ~5-44 rows and the box /
+/// mbarrier overhead outweighs the saving (L1 1024 rows +1.4%).
+const W4A4_TMA_MIN_ROWS: u32 = 2048;
+
+/// A W4A4 walk's TMA feed (`i7` = A map | B map << 16, op_moe_nvfp4_pf.cuh `nf4v_tiled`): A =
+/// `a_rows` contiguous q rows of `a`, B = the `[e * n]` weight rows of `w`, both u8 rows of `k / 2`
+/// bytes, boxes of 64 / BN rows. 0 (cp.async feed) below `W4A4_TMA_MIN_ROWS` chunk rows or when the
+/// v2 tile width BN does not divide `n`.
+#[allow(clippy::too_many_arguments)]
+fn w4a4_tmaps(
+    p: &mut Program,
+    rows: u32,
+    a: u32,
+    a_rows: u32,
+    w: u32,
+    e: u32,
+    n: u32,
+    k: u32,
+) -> u32 {
+    if rows < W4A4_TMA_MIN_ROWS {
+        return 0;
+    }
+    let bn = match n {
+        n if n % 256 == 0 => 256,
+        n if n % 192 == 0 => 192,
+        _ => return 0,
+    };
+    let mut map = |target: u32, rows: u32, box_rows: u32| {
+        p.b.tensor_gen(
+            &format!("tmap.w4a4.{target}.{rows}"),
+            128,
+            GenTensor::tmap_u8_sw64(target, rows, k / 2, box_rows),
+        )
+    };
+    let (ha, hb) = (map(a, a_rows, 64), map(w, e * n, bn));
+    assert!(
+        ha != 0 && ha < 0xFFFF && hb < 0xFFFF,
+        "W4A4 tensor-map handles exceed u16"
+    );
+    ha | hb << 16
+}
