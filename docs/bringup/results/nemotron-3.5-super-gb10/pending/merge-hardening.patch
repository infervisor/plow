+/// Cold-start burst hold (`PLOW_PF_COLD_BURST`): hand each message on `rx` to `take` while any
+/// request is still rendering ([`Ingress::rendering`]), for at most `budget`. Wakes on each
+/// message and when the last renderer settles (submits, leaves without submitting, or starts a
+/// media encode); stops when `take` returns `false` (a drain) or the channel closes.
+async fn cold_burst_wait(
+    ingress: &Ingress,
+    rx: &mut mpsc::Receiver<MuxMsg>,
+    budget: std::time::Duration,
+    mut take: impl FnMut(MuxMsg) -> bool,
+) {
+    let deadline = tokio::time::sleep(budget);
+    tokio::pin!(deadline);
+    loop {
+        let rendered = ingress.rendered.notified();
+        tokio::pin!(rendered);
+        rendered.as_mut().enable();
+        if ingress.rendering() == 0 {
+            return;
+        }
+        tokio::select! {
+            biased;
+            msg = rx.recv() => {
+                if !msg.is_some_and(&mut take) {
+                    return;
+                }
+            }
+            () = &mut rendered => {}
+            () = &mut deadline => return,
+        }
+    }
+}
