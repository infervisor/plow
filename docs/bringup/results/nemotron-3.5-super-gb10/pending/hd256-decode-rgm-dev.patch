+ * row-group mma item, PLOW_NV_FA_RG/RG_WIDE/RGM). `rows` decode rows either share slot 0 at
+ * lengths ctx .. ctx + rows - 1 (mode mtp: a speculative verify span) or own a slot each at ctx
+ * (mode batch). Checks every row against an f64 host reference on 4 heads; prints us, the GB/s of
+ * unique KV bytes and, with sm1 = s, the time of slice s of the 48-block grid alone on one SM.
+ *
+ * Build (inside nix develop):
+ *   nvcc -std=c++17 -arch=sm_121a -O3 [-DDEC_RGM=1] -I runtime/common -I runtime/nvidia \
+ *     -include cstdint runtime/tests/flashdec_hd256_sm120.cu -o flashdec_hd256
+ * Run: flashdec_hd256 [rows=4] [ctx=32768] [mode=mtp|batch] [gf=2] [nsplit=4] [iters=5] [sm1=-1]
+ * Exit 1 when a rel-L2 against the reference exceeds 2e-2. */
+#ifndef DEC_RGM
+#define DEC_RGM 0
+#endif
+#if DEC_RGM
+#define PLOW_NV_FA_RG 1
+#define PLOW_NV_FA_RG_WIDE 1
+#define PLOW_NV_FA_RGM 1
+#endif
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "sm120_common.cuh" /* pulls op_attention.cuh (d_flash_decode, d_flash_merge) */
+
+typedef __nv_bfloat16 bf16;
+
+#define CK(x) do { cudaError_t e_ = (x); if (e_ != cudaSuccess) { \
+    printf("CUDA ERROR %s at %s:%d: %s\n", #x, __FILE__, __LINE__, cudaGetErrorString(e_)); \
+    exit(2); } } while (0)
+
+static const unsigned NH = 24, NKV = 4, HD = 256;
+
+struct Geo { unsigned rows, stride, ns, slice, nblk; float scale; };
+
+template <int GF>
+__global__ void __launch_bounds__(256, 1)
+k_dec(float* Op, float* ml, const bf16* Q, const bf16* K, const bf16* V, const int* len, const int* slot, Geo g) {
+    extern __shared__ float arena[];
+    const unsigned s = g.nblk ? g.slice : blockIdx.x, n = g.nblk ? g.nblk : gridDim.x;
+    d_flash_decode<256, GF, false, false, true>(Op, ml, Q, K, V, len, g.rows, NH, NKV, g.stride, 0, g.scale,
+                                                g.ns, 0xFFFFFFFFu, s, n, arena, 0, nullptr, nullptr, slot);
+}
+__global__ void __launch_bounds__(256, 1)
+k_merge(bf16* O, const float* Op, const float* ml, unsigned rows, unsigned ns) {
+    d_flash_merge<256>(O, Op, ml, rows, NH, ns, blockIdx.x, gridDim.x);
+}
+__global__ void k_fill(bf16* p, size_t n, uint32_t seed, float amp) {
+    for (size_t i = blockIdx.x * (size_t)blockDim.x + threadIdx.x; i < n; i += (size_t)gridDim.x * blockDim.x) {
+        uint32_t x = (uint32_t)i * 2654435761u ^ seed;
+        x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+        p[i] = __float2bfloat16(amp * ((float)(int32_t)x / 2147483648.0f));
+    }
+}
+/* arena bytes as the device pass sizes them (FA_RGM_NSTG keys on PLOW_SM12X, 0 on the host pass) */
+__device__ unsigned g_smem[2] = {FA_DEC_SMEM_FLOATS(256, 2) * 4u, FA_DEC_SMEM_FLOATS(256, 6) * 4u};
+static float b2f(bf16 v) { uint16_t u; memcpy(&u, &v, 2); uint32_t w = (uint32_t)u << 16; float f; memcpy(&f, &w, 4); return f; }
+
+int main(int argc, char** argv) {
+    const unsigned R = argc > 1 ? (unsigned)atoi(argv[1]) : 4u;
+    const unsigned C = argc > 2 ? (unsigned)atoi(argv[2]) : 32768u;
+    const bool mtp = !(argc > 3 && std::string(argv[3]) == "batch");
+    const int GF = argc > 4 ? atoi(argv[4]) : 2;
+    const unsigned NS = argc > 5 ? (unsigned)atoi(argv[5]) : 4u;
+    const int iters = argc > 6 ? atoi(argv[6]) : 5;
+    const int sm1 = argc > 7 ? atoi(argv[7]) : -1;
