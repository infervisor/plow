+    cudaEvent_t e0, e1; CK(cudaEventCreate(&e0)); CK(cudaEventCreate(&e1));
+    std::vector<float> t;
+    for (int it = 0; it < iters + 1; it++) {
+        CK(cudaMemset(scrub, it, scrub_n));
+        CK(cudaEventRecord(e0));
+        kern<<<sm1 >= 0 ? 1 : grid, 256, smem>>>(Op, ml, Q, K, V, len, slot, g);
+        CK(cudaEventRecord(e1));
+        if (sm1 < 0) k_merge<<<grid, 256>>>(O, Op, ml, R, NS);
+        CK(cudaEventSynchronize(e1)); CK(cudaGetLastError());
+        float x; CK(cudaEventElapsedTime(&x, e0, e1)); if (it) t.push_back(x);
+    }
+    CK(cudaDeviceSynchronize());
+    std::sort(t.begin(), t.end());
+    const double us = 1e3 * t[t.size() / 2];
+    double kvb = 0; /* unique KV bytes: one slot's rows once (mtp), every slot (batch) */
+    if (mtp) kvb = 2.0 * NKV * (C + R - 1) * HD * 2; else kvb = 2.0 * NKV * (double)C * HD * 2 * R;
+    printf("rows %u ctx %u %s gf %d nsplit %u smem %zu%s: %9.1f us  %6.1f GB/s", R, C, mtp ? "mtp" : "batch", GF, NS,
+           smem, DEC_RGM ? " rgm" : "", us, kvb / us / 1e3);
+    if (sm1 >= 0) {
+        /* streamed bytes: every (row, GF-head group) item reads its row's K and V once; the
+         * slice's share is 1/grid of that when the items split evenly over the grid */
+        double st = 0;
+        for (unsigned r = 0; r < R; r++) st += 2.0 * (NH / GF) * (double)hl[r] * HD * 2;
+        printf("  (slice %d of %d on one SM: %.1f GB/s of its 1/%d streamed share)\n", sm1, grid,
+               st / grid / us / 1e3, grid);
+        return 0;
+    }
+    std::vector<bf16> hq(nq), ho(nq);
+    CK(cudaMemcpy(hq.data(), Q, nq * 2, cudaMemcpyDeviceToHost));
+    CK(cudaMemcpy(ho.data(), O, nq * 2, cudaMemcpyDeviceToHost));
+    const unsigned heads[] = {0, 5, 6, 23};
+    std::vector<bf16> hk((size_t)stride * HD), hv((size_t)stride * HD);
+    double rd = 0, rn = 0;
+    for (unsigned r = 0; r < R; r++)
+        for (unsigned hh : heads) {
+            const unsigned kh = hh / (NH / NKV);
+            const size_t base = ((size_t)hs[r] * NKV + kh) * stride * HD;
+            CK(cudaMemcpy(hk.data(), K + base, (size_t)stride * HD * 2, cudaMemcpyDeviceToHost));
+            CK(cudaMemcpy(hv.data(), V + base, (size_t)stride * HD * 2, cudaMemcpyDeviceToHost));
+            const unsigned n = (unsigned)hl[r];
+            std::vector<double> s(n), acc(HD, 0.0);
+            double mx = -1e300;
+            for (unsigned k = 0; k < n; k++) {
+                double d = 0;
+                for (unsigned c = 0; c < HD; c++) d += (double)b2f(hq[((size_t)r * NH + hh) * HD + c]) * b2f(hk[(size_t)k * HD + c]);
+                s[k] = d * g.scale; mx = s[k] > mx ? s[k] : mx;
+            }
+            double l = 0;
+            for (unsigned k = 0; k < n; k++) { s[k] = exp(s[k] - mx); l += s[k];
+                for (unsigned c = 0; c < HD; c++) acc[c] += s[k] * b2f(hv[(size_t)k * HD + c]); }
+            for (unsigned c = 0; c < HD; c++) {
+                const double ref = acc[c] / l, x = b2f(ho[((size_t)r * NH + hh) * HD + c]);
+                rn += ref * ref; rd += (x - ref) * (x - ref);
+            }
+        }
+    const double rel = sqrt(rd / rn);
+    printf("  rel %.2e %s\n", rel, rel <= 2e-2 ? "PASS" : "FAIL");
+    return rel <= 2e-2 ? 0 : 1;
+}
