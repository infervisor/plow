+def gb10_time(torch, fns, reps=7):
+    """CUDA-graph median us per call; eager (events around the loop) when capture fails."""
+    t0 = time.time()
+    try:
+        us, mode = bc.graph_time(torch, fns, reps=reps), "graph"
+    except Exception:
+        torch.cuda.synchronize()
+        ts = []
+        for _ in range(reps):
+            e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+            e0.record()
+            for f in fns:
+                f()
+            e1.record()
+            e1.synchronize()
+            ts.append(e0.elapsed_time(e1) * 1000 / len(fns))
+        us, mode = sorted(ts)[len(ts) // 2], "eager"
+    return us, mode, (round(t0, 1), round(time.time(), 1))
+
