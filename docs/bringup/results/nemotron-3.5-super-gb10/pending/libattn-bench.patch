+                     (16384, 16), (32768, 32), (65536, 64)]:
+        assert live_nsplit(64, kv) == want, (kv, live_nsplit(64, kv))
+    assert live_nsplit(32, 65536) == 32 and live_nsplit(16, 65536) == 16
+    assert live_nsplit(24, 131072) == 24 and live_nsplit(3, 1024) == 3
