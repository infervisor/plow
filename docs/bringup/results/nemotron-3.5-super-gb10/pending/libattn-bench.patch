+    assert [baked_nsplit(spec, r) for r in (1, 3, 4, 16, 32, 64)] == [24, 6, 6, 3, 3, 3]
+    with tempfile.NamedTemporaryFile("w", suffix=".log", delete=False) as f:
+        f.write('\x1b[2mx\x1b[0m building interpreter object from manifest requires=["PLOW_NV_FA_GF=16", '
+                '"PLOW_NV_W8A8=1", "PLOW_NV_KV_E4M3=1"] recommends=["GV_MM_MAX=32", '
+                '"PLOW_NV_FA_GF_FULL=4"]\n[ 22%] nvcc interp_sm120_pf.cubin (-DPLOW_NV_W8A8=1;'
+                '-DPLOW_CONFIG="plow_config.h";-DPLOW_NV_PREFILL=1)\n')
+    assert object_defines(f.name, "interp_sm120_pf") == [
+        "-DPLOW_NV_W8A8=1", '-DPLOW_CONFIG="plow_config.h"', "-DPLOW_NV_PREFILL=1",
+        "-DPLOW_NV_FA_GF=16", "-DPLOW_NV_KV_E4M3=1", "-DGV_MM_MAX=32"], object_defines(f.name, "interp_sm120_pf")
+    os.unlink(f.name)
+    # Head-major page ids: slot 1, KVH 2, stride 512, page 64 -> first id (1*2*512)/64 = 16.
+    assert page_id(False, 2, 512, 64, 1, 0) == 16 and page_id(False, 2, 512, 64, 1, 128) == 18
+    print("selftest OK")
