+def cmd_gb10(a):
+    drv = bc.Driver()
+    torch = drv.torch
+    nat = GbNative(drv, a.cubin, a) if a.cubin != "-" else None
+    out = {}
+    for spec in a.classes:
+        H, KVH, D, B, qlen, kvlen = [int(x) for x in spec.split(",")]
+        decode = qlen <= 8
+        per = 2 * B * KVH * kvlen * D * (1 if a.fp8 else 2) + 4 * B * qlen * H * D
+        n = max(2, min(6, math.ceil(160e6 / per)))
+        cases = [GbCase(torch, H, KVH, D, B, qlen, kvlen, a.fp8, s) for s in range(n)]
+        c0 = cases[0]
+        fl, by = c0.flop(), c0.kv_bytes()
+        floor_us = max(fl / GB10_BF16_TF / 1e6, by / GB10_DRAM * 1e6)
+        key = f"h{H}kv{KVH}d{D}_b{B}_q{qlen}_kv{kvlen}" + ("_e4m3" if a.fp8 else "")
+        res = {"floor_us": round(floor_us, 1), "gflop": round(fl / 1e9, 2), "kv_mb": round(by / 1e6, 1)}
+        windows = []
+
+        def record(name, fns, extra=None):
+            c0.o.fill_(float("nan"))
+            fns[0]()
+            torch.cuda.synchronize()
+            err = c0.reference_error()
+            us, mode, win = gb10_time(torch, fns)
+            windows.append(win)
+            r = {"us": round(us, 1), "rel_l2": float(f"{err:.2e}"), "pct_roof": round(100 * floor_us / us, 1)}
+            if decode:
+                r["gb_s"] = round(by / us / 1e3, 1)
+            else:
+                r["tflops"] = round(fl / us / 1e6, 1)
+            if mode != "graph":
+                r["timing"] = mode
+            r.update(extra or {})
+            res[name] = r
+
+        if nat is not None:
+            try:
+                built = [(nat.decode if decode else nat.prefill)(c) for c in cases]
+                record("native", [f for f, _ in built], {"nsplit": built[0][1]} if decode else None)
+            except Exception as e:
+                res["native"] = {"error": f"{type(e).__name__}: {str(e)[:300]}"}
+        for lib in a.libs:
+            if lib in ("fid", "fidtc") and qlen != 1 or lib in ("xqa", "xqac") and not decode:
+                continue
+            try:
+                arms = [GbLib(c, a.page, lib in ("fa2", "fa4", "cudnn")) for c in cases]
+                make = {"fi": lambda x: x.fi(), "fid": lambda x: x.fi(False),
+                        "fidtc": lambda x: x.fi(True), "xqa": lambda x: x.xqa(),
+                        "xqac": lambda x: x.xqa(True), "triton": lambda x: x.triton(),
+                        "fa2": lambda x: x.fa2(), "fa4": lambda x: x.fa4(),
+                        "cudnn": lambda x: x.cudnn()}[lib]
+                fns = [make(x) for x in arms]
+                extra = {}
+                if getattr(arms[0], "plan_us", 0):
+                    extra["plan_host_us"] = round(arms[0].plan_us, 1)
+                if arms[0].k is not c0.k:
+                    extra["adapter_us"] = round(gb10_time(torch, [x.adapt for x in arms])[0], 1)
+                record(lib, fns, extra)
+                if "native" in res and "us" in res["native"]:
+                    res[lib]["ratio"] = round(res[lib]["us"] / res["native"]["us"], 2)
+                del arms, fns
+            except Exception as e:
+                res[lib] = {"error": f"{type(e).__name__}: {str(e)[:300]}"}
+            torch.cuda.empty_cache()
+        res["timed_windows"] = windows
+        print(key, json.dumps(res), flush=True)
+        out[key] = res
+        del cases
+        torch.cuda.empty_cache()
+        if a.json:
+            Path(a.json).write_text(json.dumps(out, indent=1) + "\n")
+
