new file mode 100644
index 00000000..d4e70f20
--- /dev/null
+++ b/crates/plowrt/src/asset/native_ptpc.rs
@@ -0,0 +1,350 @@
+use super::devblob::{DevBlob, DevTensor};
+use crate::{Result, RuntimeError};
+use packet::dev::{DevInst64, DevOp, TENSOR_NONE16};
+use std::path::Path;
+
+pub const PROFILE: &str = "native-vllm-ptpc-w8a8-v1";
+
+pub fn instruction_uses_profile(i: &DevInst64) -> bool {
+    (i.op == DevOp::QuantFp8 as u16 && (i.i[3] != 0 || i.t[5] != TENSOR_NONE16))
+        || (i.op == DevOp::GemvFp8 as u16 && i.i[3] == 0 && i.t[3] != TENSOR_NONE16)
+        || (i.op == DevOp::Glu as u16 && i.i[2] != 0)
+}
+
+pub fn present(blob: &DevBlob) -> bool {
+    blob.progs
+        .iter()
+        .flat_map(|p| &p.insts)
+        .any(instruction_uses_profile)
+}
+
+fn fail(message: impl Into<String>) -> RuntimeError {
+    RuntimeError::Device(format!("{PROFILE}: {}", message.into()))
+}
+
+pub fn reject_unsupported(blob: &DevBlob) -> Result<()> {
+    if present(blob) {
+        return Err(fail("backend does not implement this precision profile"));
+    }
+    Ok(())
+}
+
+fn extent(tensors: &[DevTensor], id: u16, elements: u64, width: u64) -> Result<()> {
+    let size = elements
+        .checked_mul(width)
+        .ok_or_else(|| fail("tensor extent overflow"))?;
+    let tensor = tensors
+        .get(id as usize)
+        .ok_or_else(|| fail("missing tensor operand"))?;
+    if tensor.bytes < size {
+        return Err(fail(format!(
+            "{} needs {size} bytes, has {}",
+            tensor.name, tensor.bytes
+        )));
+    }
+    Ok(())
+}
+
+pub fn validate_program(insts: &[DevInst64], tensors: &[DevTensor], decode: bool) -> Result<()> {
+    let native = insts.iter().any(instruction_uses_profile);
+    if !native {
+        return Ok(());
+    }
+    let mut producers = Vec::new();
+    for i in insts {
+        if i.op == DevOp::QuantFp8 as u16 {
+            let (m, k) = (i.i[0] as u64, i.i[1] as u64);
+            if i.i[3] != 1
+                || i.i[2] != 0
+                || i.t[3] != TENSOR_NONE16
+                || i.t[4] != TENSOR_NONE16
+                || m == 0
+                || k == 0
+                || k % 8 != 0
+                || (decode && m != 1)
+                || (!decode && i.t[5] != TENSOR_NONE16)
+            {
+                return Err(fail(
+                    "invalid quant profile, fusion, phase shadow or dimensions",
+                ));
+            }
+            extent(tensors, i.t[0], m * k, 1)?;
+            extent(tensors, i.t[1], m * k, 2)?;
+            extent(tensors, i.t[2], m, 4)?;
+            if decode {
+                extent(tensors, i.t[5], m * k, 2)?;
+            }
+            producers.push((i.t[0], i.t[5], i.t[2], m, k));
+        } else if i.op == DevOp::GemvFp8 as u16 {
+            let (m, n, k, row0) = (i.i[0] as u64, i.i[1] as u64, i.i[2] as u64, i.i[4] as u64);
+            if !decode
+                || m != 1
+                || n == 0
+                || k == 0
+                || i.i[3] != 0
+                || !producers
+                    .iter()
+                    .any(|p| p.1 == i.t[1] && p.2 == i.t[3] && p.3 >= m + row0 && p.4 == k)
+            {
+                return Err(fail(
+                    "GEMV lacks a matching native quant/shadow producer or has a forbidden fold",
+                ));
+            }
+            extent(tensors, i.t[0], m * n, 2)?;
+            extent(tensors, i.t[1], (m + row0) * k, 2)?;
+            extent(tensors, i.t[2], n * k, 1)?;
+            extent(tensors, i.t[3], m + row0, 4)?;
+            extent(tensors, i.t[5], n, 4)?;
+        } else if i.op == DevOp::Glu as u16 {
+            if i.i[1] != 0 || i.i[2] != 1 || i.i[0] == 0 {
+                return Err(fail(
+                    "GELU must round BF16 activation before multiplication",
+                ));
+            }
+            for t in &i.t[..3] {
+                extent(tensors, *t, i.i[0] as u64, 2)?;
+            }
+        } else if [
+            DevOp::GemmFp8,
+            DevOp::GemmSmallFp8,
+            DevOp::GemmMedFp8,
+            DevOp::GemmWideFp8,
+            DevOp::GemmC5Fp8,
+        ]
+        .iter()
+        .any(|op| i.op == *op as u16)
+        {
+            let (m, n, k) = (i.i[0] as u64, i.i[1] as u64, i.i[2] as u64);
+            if decode
+                || m == 0
+                || n == 0
+                || k == 0
+                || i.i[4] != 0
+                || !producers
+                    .iter()
+                    .any(|p| p.0 == i.t[1] && p.2 == i.t[3] && p.3 == m && p.4 == k)
+            {
+                return Err(fail("prefill GEMM lacks a matching native quant producer"));
+            }
+            extent(tensors, i.t[0], m * n, 2)?;
+            extent(tensors, i.t[1], m * k, 1)?;
+            extent(tensors, i.t[2], n * k, 1)?;
+            extent(tensors, i.t[3], m, 4)?;
+            extent(tensors, i.t[4], n, 4)?;
+        } else if [
+            DevOp::GemvGluFp8,
+            DevOp::GemvQkvFp8,
+            DevOp::GemmGluFp8,
+            DevOp::FlashDecodeFp8,
+            DevOp::FlashPrefillFp8,
+        ]
+        .iter()
+        .any(|op| i.op == *op as u16)
+            || (i.op == DevOp::RmsNorm as u16 && i.t[3] != TENSOR_NONE16)
+        {
+            return Err(fail("incompatible fused projection/quantization or FP8 KV"));
+        }
+    }
+    Ok(())
+}
+
+pub fn validate(blob: &DevBlob, decode_start: usize, arch: &str) -> Result<bool> {
+    if !present(blob) {
+        return Ok(false);
+    }
+    if arch != "gfx942" || blob.tp.is_some() {
+        return Err(fail("requires gfx942 TP1"));
+    }
+    for (index, p) in blob.progs.iter().enumerate() {
+        if !p.insts.iter().any(instruction_uses_profile) {
+            return Err(fail("mixed legacy/native programs"));
+        }
+        validate_program(&p.insts, &blob.tensors, index >= decode_start)?;
+    }
+    Ok(true)
+}
+
+pub fn validate_export(export: &Path, checkpoint: &Path) -> Result<()> {
+    let path = export.join("quantization.json");
+    let bytes = std::fs::read(&path).map_err(|e| fail(format!("{}: {e}", path.display())))?;
+    let meta: serde_json::Value =
+        serde_json::from_slice(&bytes).map_err(|e| fail(e.to_string()))?;
+    if meta["schema"] != 1
+        || meta["complete"] != true
+        || meta["scale_mode"] != "vllm-channel"
+        || meta["weight_dtype"] != "float8_e4m3fn"
+        || meta["scale_dtype"] != "float32"
+        || meta["tensor_parallel_size"] != 1
+        || meta["sources"].as_object().is_none_or(|s| s.is_empty())
+    {
+        return Err(fail(
+            "requires complete vllm-channel FN/FP32 TP1 weight export",
+        ));
+    }
+    let config = std::fs::read(checkpoint.join("config.json")).map_err(|e| fail(e.to_string()))?;
+    if meta["config_sha256"] != plow_asset::decode_objects::image_sha256(&config) {
+        return Err(fail("weight export checkpoint config hash mismatch"));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn packet(decode: bool) -> (Vec<DevInst64>, Vec<DevTensor>) {
+        let mut q = DevInst64 {
+            op: DevOp::QuantFp8 as u16,
+            t: [TENSOR_NONE16; 8],
+            ..Default::default()
+        };
+        q.t[..3].copy_from_slice(&[0, 1, 2]);
+        q.i[0] = 1;
+        q.i[1] = 8;
+        q.i[3] = 1;
+        if decode {
+            q.t[5] = 3;
+        }
+        let mut g = DevInst64 {
+            op: if decode {
+                DevOp::GemvFp8
+            } else {
+                DevOp::GemmFp8
+            } as u16,
+            t: [TENSOR_NONE16; 8],
+            ..Default::default()
+        };
+        g.t[0] = 4;
+        g.t[1] = if decode { 3 } else { 0 };
+        g.t[2] = 5;
+        g.t[3] = 2;
+        g.t[if decode { 5 } else { 4 }] = 6;
+        g.i[0] = 1;
+        g.i[1] = 2;
+        g.i[2] = 8;
+        let ts = [8, 16, 4, 16, 4, 16, 8]
+            .iter()
+            .enumerate()
+            .map(|(n, &bytes)| DevTensor {
+                name: n.to_string(),
+                bytes,
+                init: None,
+            })
+            .collect();
+        (vec![q, g], ts)
+    }
+    #[test]
+    fn native_ptpc_gelu_rounding_is_mandatory() {
+        let (mut insts, tensors) = packet(true);
+        let mut glu = DevInst64 {
+            op: DevOp::Glu as u16,
+            ..Default::default()
+        };
+        glu.t[..3].copy_from_slice(&[1, 3, 5]);
+        glu.i[0] = 8;
+        for mode in [0, 2] {
+            glu.i[2] = mode;
+            insts.push(glu);
+            assert!(validate_program(&insts, &tensors, true).is_err());
+            insts.pop();
+        }
+        glu.i[2] = 1;
+        insts.push(glu);
+        validate_program(&insts, &tensors, true).unwrap();
+    }
+    #[test]
+    fn native_ptpc_shadow_and_phase_extents_fail_closed() {
+        for decode in [false, true] {
+            let (good, mut tensors) = packet(decode);
+            validate_program(&good, &tensors, decode).unwrap();
+            for tensor in [0, 1, 2, 4, 5, 6].into_iter().chain(decode.then_some(3)) {
+                let bytes = tensors[tensor].bytes;
+                tensors[tensor].bytes = bytes - 1;
+                assert!(
+                    validate_program(&good, &tensors, decode).is_err(),
+                    "tensor {tensor}"
+                );
+                tensors[tensor].bytes = bytes;
+            }
+            let mut bad = good.clone();
+            bad[0].i[3] = 2;
+            assert!(validate_program(&bad, &tensors, decode).is_err());
+            let mut bad = good.clone();
+            bad[0].t[3] = 1;
+            assert!(validate_program(&bad, &tensors, decode).is_err());
+            let mut bad = good.clone();
+            bad[1].t[3] = TENSOR_NONE16;
+            assert!(validate_program(&bad, &tensors, decode).is_err());
+            let mut bad = good.clone();
+            bad[1].i[4] = 1;
+            assert!(validate_program(&bad, &tensors, decode).is_err());
+            let mut bad = good.clone();
+            bad[0].t[5] = if decode { TENSOR_NONE16 } else { 3 };
+            assert!(validate_program(&bad, &tensors, decode).is_err());
+        }
+    }
+    #[test]
+    fn native_ptpc_rejects_quant_boundary_fusions() {
+        let (good, tensors) = packet(true);
+        for op in [
+            DevOp::GemvGluFp8,
+            DevOp::GemvQkvFp8,
+            DevOp::GemmGluFp8,
+            DevOp::FlashDecodeFp8,
+            DevOp::FlashPrefillFp8,
+        ] {
+            let mut bad = good.clone();
+            bad[1].op = op as u16;
+            assert!(validate_program(&bad, &tensors, true).is_err());
+        }
+        let mut bad = good.clone();
+        bad[1].i[3] = 1;
+        assert!(validate_program(&bad, &tensors, true).is_err());
+    }
+    #[test]
+    fn native_ptpc_legacy_packets_remain_accepted() {
+        let (mut legacy, tensors) = packet(true);
+        legacy[0].i[3] = 0;
+        legacy[0].t[5] = TENSOR_NONE16;
+        legacy[1].t[3] = TENSOR_NONE16;
+        validate_program(&legacy, &tensors, true).unwrap();
+        assert!(!legacy.iter().any(instruction_uses_profile));
+    }
+}
+
+#[cfg(test)]
+mod export_tests {
+    use super::*;
+    #[test]
+    fn native_ptpc_weight_export_contract_rejects_other_scale_profiles() {
+        let root =
+            std::env::temp_dir().join(format!("plow-native-ptpc-export-{}", std::process::id()));
+        std::fs::create_dir_all(&root).unwrap();
+        let config = b"{\"model_type\":\"gemma4\"}";
+        std::fs::write(root.join("config.json"), config).unwrap();
+        let good = serde_json::json!({"schema":1,"complete":true,"scale_mode":"vllm-channel","weight_dtype":"float8_e4m3fn","scale_dtype":"float32","tensor_parallel_size":1,"sources":{"weight":{}},"config_sha256":plow_asset::decode_objects::image_sha256(config)});
+        let write = |v: &serde_json::Value| {
+            std::fs::write(
+                root.join("quantization.json"),
+                serde_json::to_vec(v).unwrap(),
+            )
+            .unwrap()
+        };
+        write(&good);
+        validate_export(&root, &root).unwrap();
+        for (key, value) in [
+            ("schema", serde_json::json!(2)),
+            ("complete", serde_json::json!(false)),
+            ("scale_mode", serde_json::json!("packed-tensor")),
+            ("weight_dtype", serde_json::json!("float8_e4m3fnuz")),
+            ("scale_dtype", serde_json::json!("bfloat16")),
+            ("tensor_parallel_size", serde_json::json!(2)),
+            ("sources", serde_json::json!({})),
+            ("config_sha256", serde_json::json!("0".repeat(64))),
+        ] {
+            let mut bad = good.clone();
+            bad[key] = value;
+            write(&bad);
+            assert!(validate_export(&root, &root).is_err(), "{key}");
+        }
+    }
+}
