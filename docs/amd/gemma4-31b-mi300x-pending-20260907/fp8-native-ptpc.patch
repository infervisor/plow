diff --git a/crates/devgen/tests/native_ptpc.rs b/crates/devgen/tests/native_ptpc.rs
new file mode 100644
index 00000000..1f3e828d
--- /dev/null
+++ b/crates/devgen/tests/native_ptpc.rs
@@ -0,0 +1,104 @@
+use clap::Parser;
+use packet::dev::{DevOp, TENSOR_NONE};
+#[derive(Parser)]
+struct Args {
+    #[command(flatten)]
+    emit: devgen::emit_config::EmitConfig,
+}
+#[test]
+fn native_ptpc_emits_shared_quant_in_both_phases_and_decode_only_shadows() {
+    let root = std::path::Path::new(env!("CARGO_TARGET_TMPDIR")).join("native_ptpc_emission");
+    std::fs::create_dir_all(&root).unwrap();
+    std::fs::write(root.join("config.json"), CONFIG).unwrap();
+    let emit = Args::try_parse_from(["test", "--native-vllm-ptpc", "--emit-decode-batch", "1"])
+        .unwrap()
+        .emit;
+    let verify: devgen::VerifyHook = Box::new(|m| {
+        let lo = packet::devbuild::decode_rung_lo(&m.prog_t);
+        for (pi, p) in m.progs.iter().enumerate() {
+            let decode = pi >= lo;
+            let quants: Vec<_> = p
+                .insts
+                .iter()
+                .filter(|i| i.op == DevOp::QuantFp8 as u16)
+                .collect();
+            assert_eq!(quants.len(), 8, "four shared sites per real layer");
+            for q in quants {
+                assert_eq!(q.i[3], 1);
+                assert_eq!(q.t[3], TENSOR_NONE);
+                assert_eq!(q.t[4], TENSOR_NONE);
+                assert_eq!(q.t[5] != TENSOR_NONE, decode);
+                if decode {
+                    assert!(m.tensors[q.t[5] as usize].bytes >= q.i[1] as u64 * 2);
+                    assert!(m.tensors[q.t[5] as usize].bytes <= 21504 * 2);
+                }
+            }
+            for i in &p.insts {
+                if i.op == DevOp::Glu as u16 {
+                    assert_eq!(i.i[1], 0);
+                    assert_eq!(i.i[2], 1);
+                }
+                assert!(![DevOp::GemvGluFp8, DevOp::GemmGluFp8, DevOp::GemvQkvFp8]
+                    .iter()
+                    .any(|op| i.op == *op as u16));
+                if i.op == DevOp::GemvFp8 as u16 {
+                    assert!(decode);
+                    assert_eq!(i.i[3], 0);
+                    assert_ne!(i.t[3], TENSOR_NONE);
+                    assert!(p.insts.iter().any(|q| q.op == DevOp::QuantFp8 as u16
+                        && q.t[5] == i.t[1]
+                        && q.t[2] == i.t[3]));
+                }
+            }
+        }
+        Ok(devgen::LeanReport::skipped(
+            "Rust PTPC operand assertions only",
+        ))
+    });
+    devgen::run_verified(
+        devgen::EmitArgs {
+            dir: root.clone(),
+            ctx: 2048,
+            out: root.join("model.pkt").to_string_lossy().into_owned(),
+            n_cu: 304,
+            tp: 1,
+            block_spec: Some("0..2".into()),
+            embed_cubin: None,
+            embed_hsaco: None,
+            rope_gen: true,
+            l2_layout: None,
+            gpu: "MI300X".into(),
+            arch: "gfx942".into(),
+            emit_cfg: Some(emit),
+            whole_graph_fusions: devgen::WholeGraphFusionDecisions::default(),
+        },
+        Some(verify),
+    );
+    let manifest: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(root.join("build.json")).unwrap()).unwrap();
+    assert_eq!(manifest["features"]["native_ptpc_quant"], true);
+    assert_eq!(manifest["features"]["native_ptpc_gemv"], true);
+    assert_eq!(manifest["features"]["native_vllm_gelu"], true);
+}
+const CONFIG: &str = r#"{
+          "model_type": "gemma4_text",
+          "hidden_size": 5376,
+          "intermediate_size": 21504,
+          "num_hidden_layers": 2,
+          "num_attention_heads": 32,
+          "head_dim": 256,
+          "global_head_dim": 512,
+          "num_key_value_heads": 16,
+          "num_global_key_value_heads": 4,
+          "attention_k_eq_v": true,
+          "sliding_window": 1024,
+          "rms_norm_eps": 1e-6,
+          "vocab_size": 262144,
+          "final_logit_softcapping": 30.0,
+          "tie_word_embeddings": true,
+          "layer_types": ["sliding_attention", "full_attention"],
+          "rope_parameters": {
+            "sliding_attention": { "rope_theta": 10000.0, "partial_rotary_factor": 1.0 },
+            "full_attention": { "rope_theta": 1000000.0, "partial_rotary_factor": 0.25 }
+          }
+        }"#;
