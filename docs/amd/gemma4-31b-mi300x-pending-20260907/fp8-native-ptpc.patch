index 00000000..3ee86469
--- /dev/null
+++ b/runtime/amd/ptpc_fp8.h
@@ -0,0 +1,56 @@
+#pragma once
+
+// Native vLLM PTPC: FN448 bytes, scales half the gfx942 FNUZ224 scales.
+__device__ __forceinline__ float ptpc_div(float a, float b) {
+    bool ignored, scaled;
+    const float den = __builtin_amdgcn_div_scalef(a,b,false,&ignored);
+    const float num = __builtin_amdgcn_div_scalef(a,b,true,&scaled);
+    float r = __builtin_amdgcn_rcpf(den);
+    r = __builtin_fmaf(__builtin_fmaf(-den,r,1.f),r,r);
+    float q = num*r;
+    q = __builtin_fmaf(__builtin_fmaf(-den,q,num),r,q);
+    const float rem = __builtin_fmaf(-den,q,num);
+    q = __builtin_amdgcn_div_fmasf(rem,r,q,scaled);
+    return __builtin_amdgcn_div_fixupf(q,b,a);
+}
+
+__device__ __forceinline__ float ptpc_scale(float sum, float a, float w) {
+    float first, result;
+    // These two rounding boundaries are part of the precision profile.
+    asm volatile("v_mul_f32 %0, %1, %2" : "=v"(first) : "v"(sum), "v"(a));
+    asm volatile("v_mul_f32 %0, %1, %2" : "=v"(result) : "v"(first), "v"(w));
+    return result;
+}
+
+__device__ void d_quant_fp8_ptpc(unsigned char* q, const bf16* x, float* scale,
+                                bf16* shadow, unsigned M, unsigned K,
+                                unsigned slice, unsigned nblk, float* maxima) {
+    const unsigned lane = threadIdx.x & 63, wave = threadIdx.x >> 6;
+    for (unsigned row = slice; row < M; row += nblk) {
+        const size_t offset = (size_t)row * K;
+        float amax = 0;
+        for (unsigned k = threadIdx.x; k < K; k += blockDim.x)
+            amax = fmaxf(amax, fabsf(bf2f(x[offset+k])));
+        for (unsigned d = 32; d; d >>= 1) amax = fmaxf(amax, __shfl_xor(amax,d,64));
+        if (lane == 0) maxima[wave] = amax;
+        __syncthreads();
+        amax = lane < blockDim.x / 64 ? maxima[lane] : 0.0f;
+        for (unsigned d = 32; d; d >>= 1) amax = fmaxf(amax, __shfl_xor(amax,d,64));
+        const float s = fmaxf(ptpc_div(amax,448.f), 1.f/(448.f*512.f));
+        if (threadIdx.x == 0) scale[row] = s;
+        for (unsigned k = threadIdx.x * 2; k < K; k += blockDim.x * 2) {
+            float a = ptpc_div(bf2f(x[offset+k]),s);
+            float b = k+1 < K ? ptpc_div(bf2f(x[offset+k+1]),s) : 0;
+            a = fmaxf(-448.f,fminf(a,448.f));
+            b = fmaxf(-448.f,fminf(b,448.f));
+            unsigned p = __builtin_amdgcn_cvt_pk_fp8_f32(a*0.5f,b*0.5f,0,false);
+            q[offset+k] = (unsigned char)p;
+            if (shadow) shadow[offset+k] = plow_fp8_ocp_to_bf16((unsigned char)p);
+            if (k+1 < K) {
+                q[offset+k+1] = (unsigned char)(p >> 8);
+                if (shadow) shadow[offset+k+1] = plow_fp8_ocp_to_bf16((unsigned char)(p >> 8));
+            }
+        }
+        __syncthreads();
+    }
+}
