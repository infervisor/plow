diff --git a/crates/plowrt/tests/hsa_native_ptpc.rs b/crates/plowrt/tests/hsa_native_ptpc.rs
new file mode 100644
index 00000000..c3f00e63
--- /dev/null
+++ b/crates/plowrt/tests/hsa_native_ptpc.rs
@@ -0,0 +1,159 @@
+#![cfg(feature = "hsa")]
+use plowrt::{device::hsa::HsaBackend, exec::amd::AmdEngine};
+use std::{path::PathBuf, sync::Arc};
+
+#[test]
+fn full_model_native_ptpc_b1_vs_vllm_teacher_forced_logits() {
+    if std::env::var("PLOW_GPU_TEST").as_deref() != Ok("1") {
+        return;
+    }
+    let assets = PathBuf::from(std::env::var("PLOW_GPU_ASSETS").unwrap());
+    let reference = PathBuf::from(std::env::var("PLOW_PTPC_REFERENCE").unwrap());
+    let output = PathBuf::from(std::env::var("PLOW_PTPC_OUTPUT").unwrap());
+    std::fs::create_dir_all(&output).unwrap();
+    let manifest: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(reference.join("manifest.json")).unwrap()).unwrap();
+    assert_eq!(manifest["quantization"], "fp8_per_channel");
+    for op in ["+quant_fp8", "+gelu_and_mul"] {
+        assert!(manifest["effective_compilation_config"]["custom_ops"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .any(|v| v == op));
+    }
+    let be = Arc::new(HsaBackend::new(0).unwrap());
+    let mut engine = AmdEngine::load(
+        be,
+        &assets.join("model.pkt"),
+        &assets.join("hsaco"),
+        Some(&assets.join("checkpoint")),
+    )
+    .unwrap();
+    assert_eq!(engine.batch(), 1);
+    let mut measurements = Vec::new();
+    let mut failures = Vec::new();
+    for request in manifest["requests"].as_array().unwrap() {
+        let id = request["id"].as_str().unwrap();
+        let prompt: Vec<u32> = request["prompt_token_ids"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|v| v.as_u64().unwrap() as u32)
+            .collect();
+        let tokens: Vec<u32> = request["generated_token_ids"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|v| v.as_u64().unwrap() as u32)
+            .collect();
+        let mut token = engine.prefill_slot(0, &prompt).unwrap();
+        for (step, &expected_token) in tokens.iter().enumerate() {
+            if step > 0 {
+                engine
+                    .write_tensor("in.ids", bytemuck::cast_slice(&[tokens[step - 1]]))
+                    .unwrap();
+                let pos = (prompt.len() + step - 1) as u32;
+                let dp = engine.decode_prog_for(1);
+                token = engine
+                    .decode_step_batched_at(&[pos], &[pos + 1], dp)
+                    .unwrap()[0];
+            }
+            let row_id = format!("{id}.step{step:04}");
+            let row = manifest["cases"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .find(|c| c["id"] == row_id)
+                .unwrap();
+            let raw = std::fs::read(reference.join(row["file"].as_str().unwrap())).unwrap();
+            let ref_logits: Vec<f32> = raw
+                .chunks_exact(4)
+                .map(|b| f32::from_le_bytes(b.try_into().unwrap()))
+                .collect();
+            let mut raw = vec![0u8; engine.tensor_bytes("act.logits").unwrap() as usize];
+            engine.read_tensor("act.logits", &mut raw).unwrap();
+            let actual: Vec<f32> = raw
+                .chunks_exact(2)
+                .map(|b| f32::from_bits((u16::from_le_bytes(b.try_into().unwrap()) as u32) << 16))
+                .collect();
+            assert_eq!(actual.len(), ref_logits.len());
+            std::fs::write(
+                output.join(format!("logits_{row_id}.f32")),
+                bytemuck::cast_slice(&actual),
+            )
+            .unwrap();
+            let (mut error, mut norm, mut max_abs) = (0f64, 0f64, 0f32);
+            let mut count = 0;
+            for (&a, &b) in actual.iter().zip(&ref_logits) {
+                if !b.is_finite() {
+                    continue;
+                }
+                assert!(a.is_finite(), "{row_id} nonfinite Plow logit");
+                let diff = a - b;
+                error += (diff as f64).powi(2);
+                norm += (b as f64).powi(2);
+                max_abs = max_abs.max(diff.abs());
+                count += 1;
+            }
+            let l2 = (error / norm.max(1e-30)).sqrt();
+            let record = serde_json::json!({"id":row_id,"relative_l2":l2,"max_abs":max_abs,"finite_compared":count,"actual_token":token,"reference_token":expected_token,"same_argmax":token==expected_token,"teacher_forced":true});
+            eprintln!("{record}");
+            measurements.push(record);
+            if l2 > 0.01 || max_abs > 0.5 || token != expected_token {
+                failures.push(row_id);
+            }
+        }
+    }
+    std::fs::write(output.join("comparison.json"),serde_json::to_vec_pretty(&serde_json::json!({"profile":"native-vllm-ptpc-w8a8-v1","mode":"actual AMD full-model B1; teacher-forced native-vLLM tokens","relative_l2_limit":0.01,"max_abs_limit":0.5,"measurements":measurements,"failures":failures})).unwrap()).unwrap();
+    assert!(
+        failures.is_empty(),
+        "PTPC full-model qualification failed: {failures:?}"
+    );
+}
+
+#[test]
+fn native_ptpc_layer_snapshot() {
+    if std::env::var("PLOW_PTPC_SNAPSHOT").as_deref() != Ok("1") {
+        return;
+    }
+    let assets = PathBuf::from(std::env::var("PLOW_GPU_ASSETS").unwrap());
+    let output = PathBuf::from(std::env::var("PLOW_PTPC_OUTPUT").unwrap());
+    std::fs::create_dir_all(&output).unwrap();
+    let raw = std::fs::read(assets.join("model.pkt")).unwrap();
+    let blob = plowrt::asset::devblob::DevBlob::parse_l2(&raw, true).unwrap();
+    let names: Vec<_> = blob
+        .tensors
+        .iter()
+        .filter(|t| t.name.starts_with("act.") && t.bytes <= 32 * 1024 * 1024)
+        .map(|t| (t.name.clone(), t.bytes))
+        .collect();
+    let be = Arc::new(HsaBackend::new(0).unwrap());
+    let mut engine = AmdEngine::load(
+        be,
+        &assets.join("model.pkt"),
+        &assets.join("hsaco"),
+        Some(&assets.join("checkpoint")),
+    )
+    .unwrap();
+    let prompt: Vec<_> = (0..128).map(|i| 100 + i % 100).collect();
+    let first = engine.prefill_slot(0, &prompt).unwrap();
+    let mut metadata = Vec::new();
+    for phase in ["prefill", "decode"] {
+        if phase == "decode" {
+            engine
+                .write_tensor("in.ids", bytemuck::cast_slice(&[240017u32]))
+                .unwrap();
+            let dp = engine.decode_prog_for(1);
+            engine.decode_step_batched_at(&[128], &[129], dp).unwrap();
+        }
+        for (name, bytes) in &names {
+            let data = engine.snapshot_tensor(name).unwrap();
+            assert_eq!(data.len(), *bytes as usize);
+            let file = format!("{phase}.{name}.bin");
+            std::fs::write(output.join(&file), data).unwrap();
+            metadata
+                .push(serde_json::json!({"phase":phase,"tensor":name,"bytes":bytes,"file":file}));
+        }
+    }
+    std::fs::write(output.join("manifest.json"),serde_json::to_vec_pretty(&serde_json::json!({"probe":"one-layer real-weight prefix; not full-model quality","prefill_token":first,"prompt_token_ids":prompt,"decode_input":240017,"tensors":metadata})).unwrap()).unwrap();
+}
