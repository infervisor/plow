+                            let prompt: Vec<_> = (0..length).map(|i| 100 + ((i + slot * 7) % 100) as u32).collect();
+                            let id = engine.prefill(slot, &prompt).unwrap();
+                            feeds.push((slot, id));
+                        }
+                        let Ranks::One(rank) = &mut engine.ranks else { unreachable!() };
+                        rank.capture_system_release = mode == "system_device";
+                        let before_drain = rank.seg_drain_us;
