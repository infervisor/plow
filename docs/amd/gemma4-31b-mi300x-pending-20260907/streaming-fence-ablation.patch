+                        let mut generated = Vec::with_capacity(batch * 64);
+                        let started = std::time::Instant::now();
+                        for _ in 0..64 / quantum {
+                            if mode == "system_host" {
+                                assert_eq!(engine.multi_step_streamed(&feeds, quantum, &mut out, &mut |tokens| {
+                                    generated.extend_from_slice(&tokens[..batch]);
+                                    true
+                                }).unwrap(), Some(quantum));
+                                for slot in 0..batch { feeds[slot].1 = out[slot]; }
+                            } else {
+                                assert_eq!(engine.multi_step(&feeds, quantum, &mut out).unwrap(), quantum);
+                                for step in 0..quantum {
+                                    generated.extend((0..batch).map(|slot| out[slot * quantum + step]));
+                                }
+                                for slot in 0..batch { feeds[slot].1 = out[slot * quantum + quantum - 1]; }
+                            }
+                        }
