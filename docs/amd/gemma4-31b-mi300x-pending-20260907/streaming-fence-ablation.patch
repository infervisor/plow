+            let mut records = Vec::new();
+            for (length, batch, quantum) in [(1024, 4, 2), (4096, 1, 4)] {
+                let mut expected = None;
+                for (repetition, order) in [
+                    ["agent_device", "system_device", "system_host"],
+                    ["system_host", "agent_device", "system_device"],
+                    ["system_device", "system_host", "agent_device"],
+                    ["agent_device", "system_device", "system_host"],
+                ].into_iter().enumerate() {
+                    for mode in order {
