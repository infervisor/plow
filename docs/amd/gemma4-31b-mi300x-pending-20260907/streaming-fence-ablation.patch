+mod host_capture_tests {
+    use super::*;
+
+    #[test]
+    fn host_capture_system_release_publishes_reused_cached_ring() {
+        if std::env::var("PLOW_GPU_TEST").as_deref() != Ok("1") {
+            return;
+        }
+        let be = HsaBackend::new(0).unwrap();
+        let object = std::env::var("PLOW_HOST_CAPTURE_OBJECT").unwrap();
+        let module = Backend::module_load(&be, &std::fs::read(object).unwrap()).unwrap();
+        let kernel = be.get_function(&module, "plow_token_capture").unwrap();
+        let ids = Backend::alloc(&be, 0, 8 * 4).unwrap();
+        let device_ring = Backend::alloc(&be, 0, 8 * 8 * 4).unwrap();
+        let mut host_ring = be.host_alloc_pinned(8 * 8 * 4).unwrap();
+        let mut staging = be.host_alloc_pinned(8 * 4).unwrap();
+        let mut back = be.host_alloc_pinned(8 * 8 * 4).unwrap();
+        let args = |ring: u64, batch: usize, step: usize, quantum: usize| {
+            let mut args = [0u8; 32];
+            args[..8].copy_from_slice(&ids.base.to_le_bytes());
+            args[8..16].copy_from_slice(&ring.to_le_bytes());
+            args[16..20].copy_from_slice(&(step as u32).to_le_bytes());
+            args[20..24].copy_from_slice(&(quantum as u32).to_le_bytes());
+            args[24..28].copy_from_slice(&(batch as u32).to_le_bytes());
+            args
+        };
+        let mut checked = 0;
+        for batch in [1, 4, 8] {
+            for quantum in [1, 2, 4, 8] {
+                for round in 0..256u32 {
+                    host_ring.as_mut_slice().fill(0xa5);
+                    std::hint::black_box(host_ring.as_slice().iter().fold(0u8, |a, &b| a ^ b));
+                    for step in 0..quantum {
+                        for row in 0..batch {
+                            let token = round * 1000 + step as u32 * 10 + row as u32;
+                            staging.as_mut_slice()[row * 4..row * 4 + 4].copy_from_slice(&token.to_le_bytes());
+                        }
+                        be.memcpy_htod_pinned(ids.base, &staging.as_slice()[..batch * 4]).unwrap();
+                        let a = args(host_ring.as_ptr() as usize as u64, batch, step, quantum);
+                        be.launch_host_visible(kernel, 1, 256, 0, &a).unwrap();
+                        be.synchronize().unwrap();
+                        for row in 0..batch {
+                            let offset = (row * quantum + step) * 4;
+                            let actual = u32::from_le_bytes(host_ring.as_slice()[offset..offset + 4].try_into().unwrap());
+                            assert_eq!(actual, round * 1000 + step as u32 * 10 + row as u32);
+                            checked += 1;
+                        }
+                    }
+                }
+            }
+        }
+        eprintln!("PASS {checked} exact host token values; cached ring reuse across 12 batch/quantum shapes");
+        for (batch, quantum) in [(1, 4), (4, 2)] {
+            for direct in [false, true] {
+                let start = std::time::Instant::now();
+                for _ in 0..1000 {
+                    for step in 0..quantum {
+                        let ring = if direct { host_ring.as_ptr() as usize as u64 } else { device_ring.base };
+                        let a = args(ring, batch, step, quantum);
+                        if direct { be.launch_host_visible(kernel, 1, 256, 0, &a).unwrap(); }
+                        else { be.launch(kernel, 1, 256, 0, &a).unwrap(); }
+                        be.synchronize().unwrap();
+                        if direct { std::hint::black_box(host_ring.as_slice()[step * 4]); }
+                    }
+                    if !direct {
+                        be.memcpy_dtoh_pinned(&mut back.as_mut_slice()[..batch * quantum * 4], device_ring.base).unwrap();
+                    }
+                }
+                eprintln!("capture-only batch={batch} quantum={quantum} direct={direct} us/quantum={:.3}", start.elapsed().as_secs_f64() * 1e3);
+            }
+        }
+    }
+}
