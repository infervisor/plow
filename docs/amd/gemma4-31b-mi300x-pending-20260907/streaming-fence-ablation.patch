+            .ok_or_else(|| RuntimeError::Device("host token ring is absent".into()))?;
+        // Only called after decode_batched_host_at has drained successfully. No borrow
+        // of the GPU-written allocation survives the next dispatch.
+        let bytes = ring.as_slice();
+        out.clear();
+        out.extend((0..batch).map(|row| {
+            let offset = (row * quantum + step) * 4;
+            u32::from_le_bytes(bytes[offset..offset + 4].try_into().expect("4"))
+        }));
+        Ok(())
+    }
