; Operator-graph schema for the rewriting half (Stage-2 fusion slice).
; Mirrors the nn-graph ops. Leaves carry the tensor name so extraction can map
; back to weights/inputs. Attributes that fusion does not reason about (shapes,
; attention config) ride along as opaque tokens. Fused targets have fewer
; e-nodes than the forms they replace, so the tree-size cost prefers them at
; extraction. There are NO explicit cost annotations — see the "Extraction
; cost" note in rules.egg, which this comment used to contradict.
;
; LIMIT worth knowing before extending this schema: attention is modelled as
; `(Attention Expr Expr Expr String)` with the whole attention config collapsed
; into one opaque token. Rules cannot branch on attention attributes; graph
; construction must make distinctions such as shared K/V edges explicit.

(datatype Expr
  (Input String)                       ; named graph input
  (Weight String)                      ; named model weight

  ; --- core ops (text decoders) ---
  (Embedding Expr Expr)                ; ids, table
  (Scale Expr f64)                     ; x, factor
  (RmsNorm Expr Expr f64)              ; x, weight, eps
  (UnitRmsNorm Expr f64)               ; x, eps (no learned scale)
  (ZeroCenteredRmsNorm Expr Expr f64)  ; x, offset-from-one weight, eps
  (LayerNorm Expr Expr Expr f64)       ; x, weight, bias, eps
  (Linear Expr Expr i64)              ; x, weight, out_features
  (LinearBias Expr Expr Expr i64)     ; x, weight, bias, out_features
  (MatMul Expr Expr)                   ; a, b
  (Reshape Expr String)               ; x, shape-token
  (Transpose Expr String)             ; x, perm-token
  (Rope Expr i64 f64)                 ; x, rotary_dim, theta
  (ProportionalRope Expr i64 f64 i64) ; x, rotary_dim, theta, frequency_dim
  (Attention Expr Expr Expr String)   ; q, k, v, config-token (opaque attrs)
  (Ew String Expr Expr)               ; kind, a, b
  (Act String Expr)                   ; kind, x
  (Softmax Expr i64)                  ; x, axis

  ; --- sequence / shape manipulation ---
  (Concat i64 Expr Expr)              ; axis, a, b (binary; n-ary chains)
  (Slice Expr i64 String String)      ; x, axis, start-token, len-token (possibly symbolic)
  (Broadcast Expr String)             ; x, shape-token
  (Reduce String Expr i64)            ; kind, x, axis

  ; --- spatial ops (vision / VAE) ---
  (Conv2d Expr Expr String String)         ; x, weight, stride-tok, padding-tok
  (Conv2dBias Expr Expr Expr String String) ; x, weight, bias, stride-tok, padding-tok
  (Conv3d Expr Expr String String)         ; x, weight, stride-tok, padding-tok
  (Conv3dBias Expr Expr Expr String String) ; x, weight, bias, stride-tok, padding-tok
  (GroupNorm Expr Expr Expr i64 f64)   ; x, weight, bias, groups, eps

  ; --- routing (MoE) ---
  (MoeRouter Expr Expr i64 i64)       ; x, weight, num_experts, top_k
  (MoeRouterGrouped Expr Expr i64 i64 i64 i64)
      ; x, weight, num_experts, top_k, n_group, topk_group

  ; --- Kimi-K3 ---
  ; The hybrid mixer's terms. Every weight leaf is named so the manifest stays
  ; complete: these were previously REFUSED by `lower.rs` rather than lowered to
  ; `Opaque`, because `Opaque` is a single-input passthrough and would have
  ; dropped every weight but the first.
  (Conv1dDepthwise Expr Expr i64)     ; x, weight, kernel  (KDA's short causal conv)
  (SituGlu Expr Expr f64 f64)         ; gate, up, beta, linear_beta
  ; q, k, v, gate, beta, A_log, dt_bias, kind-token, num_heads, head_dim. The recurrent state is
  ; a runtime resource, not an edge — same convention as `Attention` and the KV
  ; cache (see `nn_graph::Op::LinearAttention`).
  (LinearAttention Expr Expr Expr Expr Expr Expr Expr String i64 i64)

  ; K3's block residual. The snapshot stack is variable-length (0..max_snapshots),
  ; so it rides as a cons chain — the `Concat` precedent above, for the same
  ; reason: egglog constructors are fixed-arity and no leaf may be dropped.
  (BlockResidual Expr Expr Expr Expr i64)  ; prefix, snapshots, norm_weight, proj_weight, max_snapshots
  (SnapCons Expr Expr)                ; snapshot, rest
  (SnapNil)                           ; end of the snapshot chain

  ; --- catch-all for ops not yet in the fusion vocabulary ---
  ; Allows the full graph to lower without error; no rewrite targets Opaque.
  (Opaque String Expr)                ; op_name, single-input passthrough

  ; === fused targets ===
  ; Norm→Linear fusions keep EVERY weight leaf (norm bias, linear bias) so the
  ; fused kernel reproduces the math and the weight manifest stays complete.
  (FusedNormLinear Expr Expr Expr f64 i64)             ; x, normw, linw, eps, out  (RMSNorm + biasless Linear)
  (FusedZeroCenteredNormLinear Expr Expr Expr f64 i64) ; x, normw, linw, eps, out
  (FusedNormLinearBias Expr Expr Expr Expr f64 i64)    ; x, normw, linw, linb, eps, out  (RMSNorm + biased Linear)
  (FusedLayerNormLinear Expr Expr Expr Expr f64 i64)   ; x, normw, normb, linw, eps, out
  (FusedLayerNormLinearBias Expr Expr Expr Expr Expr f64 i64) ; x, normw, normb, linw, linb, eps, out
  (SwiGLU String Expr Expr)                   ; act kind, gate_proj_out, up_proj_out
  (FusedGroupNormAct Expr Expr Expr i64 f64 String)  ; x, w, b, groups, eps, act
  (FusedAdaLN Expr Expr Expr)                 ; x, scale, shift
  (FusedGatedResidual Expr Expr Expr)         ; x, y, gate

  ; Norm→Rope fusions (Gemma3/4 qk_norm: RmsNorm immediately before RoPE).
  (FusedNormRope Expr Expr f64 i64 f64)       ; x, normw, eps, rotary_dim, theta
  (FusedZeroCenteredNormRope Expr Expr f64 i64 f64)
  (FusedNormRopeScale Expr Expr f64 i64 f64 f64) ; x, normw, eps, rotary_dim, theta, scale_factor

  ; Residual-add + Norm fusion (fires at every block boundary in LLMs).
  (FusedResidualNorm Expr Expr Expr f64)             ; a, b, normw, eps  (add(a,b) then RMSNorm)
  (FusedResidualZeroCenteredNorm Expr Expr Expr f64) ; add(a,b) then zero-centered RMSNorm
  (FusedResidualLayerNorm Expr Expr Expr Expr f64)   ; a, b, normw, normb, eps

  ; GroupNorm + Activation + Conv3d fusion (VAE resnet inner loop).
  (FusedGroupNormActConv3d Expr Expr Expr i64 f64 String Expr String String)
      ; x, gnW, gnB, groups, eps, act, convW, stride-tok, pad-tok
  (FusedGroupNormActConv3dBias Expr Expr Expr i64 f64 String Expr Expr String String)
      ; x, gnW, gnB, groups, eps, act, convW, convB, stride-tok, pad-tok

  ; Linear + Activation fusion (non-gated MLP paths: SigLIP, DiT).
  (FusedLinearAct Expr Expr i64 String)              ; x, weight, out, act_kind
  (FusedLinearBiasAct Expr Expr Expr i64 String)     ; x, weight, bias, out, act_kind

  ; Embedding + Scale fusion (Gemma embedding normalizer).
  (FusedEmbeddingScale Expr Expr f64)              ; ids, table, factor

  ; Kimi-K3 gate fusions. Both targets are opcodes that ALREADY EXIST and are
  ; already numerically gated on real weights — `KdaGatedNorm = 103` and
  ; `MlaOutGate = 106`. The unfused graph spells each as 3-5 e-nodes, so these
  ; rules are what lets extraction reach a kernel the runtime can already run.
  (FusedKdaGatedNorm Expr Expr f64 Expr Expr i64 String)
      ; o, o_normw, eps, x, gatew, gate_out, gate-shape
  (FusedMlaOutGate Expr Expr Expr i64)             ; attn, x, gatew, gate_out

  ; Qwen3.5/3.8 output gates. Keep the packed q_proj slice attributes so this
  ; cannot alias Kimi's independently projected sigmoid gate.
  (FusedRmsNormSiluGate Expr Expr f64 Expr String)
      ; x, normw, eps, gate, gate-shape
  (FusedPackedAttnGate Expr Expr Expr i64 String i64 String String String)
      ; mixer, q-input, q-weight, q-out, packed-shape, axis, start, len, gate-shape

  ; A compatible block-residual consumer may compute its immediately preceding residual
  ; in-kernel, but must still write that BF16 tensor for its other users. The three-input form is
  ; distinct so its inner add remains a materialization/rounding point.
  (FusedMaterializedResidualBlock Expr Expr Expr Expr Expr i64)
      ; a, b, snapshots, norm_weight, proj_weight, max_snapshots
  (FusedMaterializedResidual3Block Expr Expr Expr Expr Expr Expr i64))
      ; pre, a, b, snapshots, norm_weight, proj_weight, max_snapshots
