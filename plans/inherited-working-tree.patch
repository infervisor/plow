+fn glm_qkva_w8a8_routes_replicated_weights_and_three_outputs() {
+    let _guard = crate::test_env::env_guard();
+    let _env = crate::test_env::EnvScope::set(&[
+        ("GLM_LINEAR_FP8", "1"), ("PLOW_GLM_QKVA_W8A8", "1"),
