command'])\n  log=pathlib.Path(j['log']);xml=pathlib.Path(j['command'][j['command'].index('--save')+1]);rec=v.inspect_log(log.read_text());rec['xml']=v.inspect_xml(xml);rec.update(name=j['name'],raw_returncode=99,tool_exit_zero=False)\n  m=j['M'];ctx=j['context'];n.P=M;n.run(m,ctx)\n  n.P=G;_,base=oldread('s8',m,ctx);n.P=M;_,actual=oldread('s8',m,ctx)\n  for a,b in zip(base,actual):\n   assert a['act.fu']==b['act.fu']\n   for tensor,limit in [('act.dg',.006),('act.x',.01)]:\n    aa=n.A.bf(a[tensor]);bb=n.A.bf(b[tensor])\n    for row in range(m):n.A.compare(aa[row*n.N:(row+1)*n.N],bb[row*n.N:(row+1)*n.N],limit);comparisons+=1\n  records.append(rec)\n  for f in [log,xml,*pathlib.Path(j['output']).rglob('*')]:\n   if f.is_file():files[str(f)]=sha(f)\n assert len(records)==2\n report=dict(qualified_with_exact_optional_api_probes=True,tool_exit_zero=False,records=records,instrumented_vs_frozen_control_rows=240,instrumented_vs_frozen_candidate_rows=comparisons,scratch_cast_guard_checks=12,reset_checks=True,host_sha256=v.HOST_SHA,scope='Native sliding block0 M4/1K andM16/32K staticLIVE0 only; raw99 retained, no other sanitizer records',files=files)\n (P/'qualification.json').write_text(json.dumps(report,indent=2)+'\\n');print(json.dumps({k:x for k,x in report.items() if k!='files'}))\ndef selftest():\n j=json.loads((W/'queue.json').read_text())['jobs'][0];text=pathlib.Path(j['log']).read_text();v.inspect_log(text)\n mutants=[text.replace('error 500','error 700',1),text.replace('cuModuleGetGlobal_v2','cuMemAlloc_v2',1),text.replace('1677cc','1677cd',1),text.replace('16652b','16652c',1),text.replace('1429fe','1429ff',1),text.replace('ERROR SUMMARY: 2 errors','ERROR SUMMARY: 0 errors'),text.replace(v.API+'\\n','',1),text+'\\n========= Invalid __global__ read of size4 bytes\\n',text.replace(' in decode_dump_prefix',' in other_host',1),text.replace('COMPUTE-SANITIZER','',1)]\n for x in mutants:\n  try:v.inspect_log(x)\n  except ValueError:pass\n  else:raise AssertionError('Accepted mutated log')\n xml=pathlib.Path(j['command'][j['command'].index('--save')+1]).read_text()\n mutants_xml=[xml.replace('<kind>Api</kind>','<kind>Memory</kind>',1),xml.replace('0x16652b','0x16652c',1),xml.replace('<result>500</result>','<result>700</result>',1),xml.replace('</ComputeSanitizerOutput>','<record><kind>Memory</kind></record></ComputeSanitizerOutput>'),xml.replace('<pc>0x1429fe</pc>','<pc>0x1429ff</pc>',1),xml.replace('decode_dump_prefix','other_host',1)]\n with tempfile.TemporaryDirectory() as d:\n  f=pathlib.Path(d)/'bad.xml'\n  for x in mutants_xml:\n   f.write_text(x)\n   try:v.inspect_xml(f)\n   except ValueError:pass\n   else:raise AssertionError('Accepted mutated XML')\n n.self_test();(P/'cpu-tests.json').write_text(json.dumps(dict(passed=True,log_mutations_rejected=10,xml_mutations_rejected=6,native_numeric_selftests=True),indent=2)+'\\n')\nif __name__=='__main__':selftest();run()\n"
