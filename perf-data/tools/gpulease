#!/usr/bin/env bash
# Serialize GPU access across concurrent agents. Vendor-neutral: NVIDIA
# (nvidia-smi) and AMD/ROCm (amd-smi). Multi-GPU boxes lease PER GPU.
#   gpulease <label> <command...>          exclusive: lease EVERY GPU
#   gpulease -n <k> <label> <command...>   lease k free GPUs, pin the child to them
#   gpulease --max-hold <s> ...            hold limit for this run (0 = none)
#   gpulease --status | status             holders, queue + VRAM
#   gpulease --audit | audit               list foreign GPU processes right now
# Waiters are served FIFO (ticket queue): a later request may only take cards no older
# waiter needs, so nobody starves behind newcomers. The command runs in its own process
# group, killed as a whole when it exits, when the lease is killed, or when it outlives
# the hold limit while someone is waiting; nothing keeps a card after its lease ends.
# NOTE: the lease is ADVISORY (flock). It cannot stop a process that never calls
# it. So we also AUDIT for foreign compute processes before/after and WARN loudly,
# because a contended run silently invalidates every timing number.
#
# A -n<k> run exports CUDA_VISIBLE_DEVICES / HIP_VISIBLE_DEVICES /
# ROCR_VISIBLE_DEVICES to exactly the leased ids, so the child cannot touch a
# card it does not hold. Audit is then scoped to the leased cards only.
#
# Env:
#   GPU_LEASE_DIR      lock/log dir (default: /workspace/gpu, else /tmp/gpulease)
#   GPU_LEASE_TIMEOUT  seconds to wait for the lease (default 1800)
#   GPU_LEASE_NGPU     override detected GPU count
#   GPU_LEASE_MAX_HOLD seconds a run may hold cards while others wait (default 7200;
#                      0 = no limit). Past it the run is stopped (rc 124, PREEMPTED).
#   GPU_LEASE_VENDOR   override vendor detection (nvidia|amd|none)

TIMEOUT=${GPU_LEASE_TIMEOUT:-1800}
MAX_HOLD=${GPU_LEASE_MAX_HOLD:-7200}

# `gpulease status` used to lease the box under the label "status" and run nothing.
if [ "$#" -eq 1 ]; then
  case "$1" in status|audit) set -- "--$1" ;; esac
fi

# ---- lease dir. The old hard-coded /workspace/gpu does not exist on every box
# (and is not creatable as non-root), which made every call die in `exec 9>`.
if [ -n "$GPU_LEASE_DIR" ]; then
  LEASE_DIR="$GPU_LEASE_DIR"
elif mkdir -p /workspace/gpu 2>/dev/null; then
  LEASE_DIR=/workspace/gpu
else
  # TMPDIR is deliberately not used here. `nix develop` assigns a fresh
  # /tmp/nix-shell.* directory to each invocation; deriving locks from it lets
  # concurrent shells acquire disjoint leases for the same physical GPUs.
  LEASE_DIR=/tmp/gpulease
fi
mkdir -p "$LEASE_DIR" 2>/dev/null || { echo "gpulease: cannot create $LEASE_DIR" >&2; exit 1; }
chmod 1777 "$LEASE_DIR" 2>/dev/null || true
LOG="$LEASE_DIR/lease.log"
if [ -e "$LOG" ] && [ ! -w "$LOG" ]; then
  LOG="$LEASE_DIR/lease.$(id -u).log"
fi

# ---- vendor detect
if [ -n "$GPU_LEASE_VENDOR" ]; then VENDOR=$GPU_LEASE_VENDOR
elif command -v nvidia-smi >/dev/null 2>&1; then VENDOR=nvidia
elif command -v amd-smi >/dev/null 2>&1; then VENDOR=amd
else VENDOR=none
fi

ngpu() {
  [ -n "$GPU_LEASE_NGPU" ] && { echo "$GPU_LEASE_NGPU"; return; }
  case "$VENDOR" in
    nvidia) nvidia-smi --query-gpu=index --format=csv,noheader 2>/dev/null | wc -l ;;
    amd)    amd-smi process --json 2>/dev/null | grep -c '"gpu":' ;;
    *)      echo 0 ;;
  esac
}
NGPU=$(ngpu); [ "$NGPU" -ge 1 ] 2>/dev/null || NGPU=1

# Can we even ATTRIBUTE a GPU pid? The SMI tools report HOST pids; inside a PID
# namespace (container) none of them resolve in our /proc, so every process —
# including our own child — looks "foreign" and the audit is pure noise. Detect
# that once and degrade to lock-only rather than reporting false contention.
# Returns 0 (attributable) only if at least one reported pid exists for us.
pid_ns_ok() {
  local pids p
  pids=$(all_gpu_pids)
  [ -z "$pids" ] && return 0          # nothing on the GPU: nothing to misattribute
  for p in $pids; do [ -e "/proc/$p" ] && return 0; done
  return 1
}

# "<gpu_index> <pid> <mem>" per line, for every compute process on the box.
gpu_procs() {
  case "$VENDOR" in
    nvidia)
      # nvidia-smi cannot attribute a pid to an index in one query; the NVIDIA
      # boxes this harness came from are single-GPU, so report index 0.
      nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader 2>/dev/null |
        while IFS=, read -r p mem; do
          p=$(echo "$p" | tr -d ' '); [ -z "$p" ] && continue
          echo "0 $p $(echo "$mem" | tr -d ' ')"
        done ;;
    amd)
      amd-smi process --json 2>/dev/null | python3 -c '
import json,sys
try: data=json.load(sys.stdin)
except Exception: sys.exit(0)
for e in data if isinstance(data,list) else []:
    g=e.get("gpu")
    for p in e.get("process_list") or []:
        info=p.get("process_info") if isinstance(p,dict) else None
        if not isinstance(info,dict):
            continue                      # "No running processes detected"
        pid=info.get("pid")
        if pid is None: continue
        mem=info.get("memory_usage") or {}
        vram=mem.get("vram_mem") if isinstance(mem,dict) else None
        print(g,pid,vram if vram is not None else "?")
' 2>/dev/null ;;
  esac
}

all_gpu_pids() { gpu_procs | awk '{print $2}' | sort -u; }

# 0 if $1 is this lease shell or ANY descendant of it. The leased command is
# exec'd as a child, so comparing against $$ alone (what this used to do) made
# every leased run report its own compute process as foreign — which forced RC
# to 76 on success, so rc=76 carried no contention information at all.
is_ours() {
  local p="$1" i=0
  while [ -n "$p" ] && [ "$p" != "0" ] && [ "$i" -lt 64 ]; do
    [ "$p" = "$$" ] && return 0
    p=$(awk '/^PPid:/{print $2}' "/proc/$p/status" 2>/dev/null)
    i=$((i + 1))
  done
  return 1
}

# GPUs with a non-trivial VRAM allocation, as a space-separated id list.
#
# WHY THIS EXISTS: on this ROCm build `amd-smi process --json` reports the SAME
# process list under EVERY gpu entry, so its per-GPU attribution is fiction. The
# effect is that any agent's plowrt anywhere makes all 8 cards read as contended
# and EVERY run returns rc=76 — which makes the "re-run on rc=76" rule
# unfollowable, and (worse) trains people to ignore the one signal that protects
# a measurement.
#
# Per-GPU VRAM, unlike per-GPU pid lists, IS reliable. A real compute tenant
# holds memory; a card at ~0% cannot be hosting one. So we intersect the (untrusted)
# pid attribution with the (trusted) memory signal, which removes the false
# positives without weakening true detection.
busy_gpus() {
  case "$VENDOR" in
    amd)
      rocm-smi --showmemuse --json 2>/dev/null | python3 -c '
import json,sys,re
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
for k,v in (d.items() if isinstance(d,dict) else []):
    m=re.match(r"card(\d+)",k)
    if not m: continue
    for kk,vv in (v.items() if isinstance(v,dict) else []):
        if "VRAM%" in kk or "Memory Allocated" in kk:
            try:
                if float(vv) >= 1.0: print(m.group(1))
            except (TypeError,ValueError): pass
' 2>/dev/null | sort -u | tr '\n' ' ' ;;
    *) echo "" ;;   # nvidia path attributes correctly; do not filter
  esac
}

# pids using the LEASED gpus that are not us or our descendants.
# $1 (optional) = space-separated gpu ids to scope to; empty = all.
foreign() {
  pid_ns_ok || return 0              # namespaced: cannot attribute, report nothing
  local scope="${1:-}"
  local busy; busy="$(busy_gpus)"
  gpu_procs | while read -r g p mem; do
    [ -z "$p" ] && continue
    if [ -n "$scope" ]; then
      case " $scope " in *" $g "*) ;; *) continue ;; esac
    fi
    # Drop the report if this card holds no memory (see busy_gpus). Only applied
    # when the VRAM probe actually returned something, so a probe failure
    # degrades to the old, noisier-but-safe behaviour rather than to silence.
    if [ "$VENDOR" = amd ] && [ -n "$busy" ]; then
      case " $busy " in *" $g "*) ;; *) continue ;; esac
    fi
    # A container's workload is a child of containerd, NEVER of this shell, so
    # is_ours() cannot recognise our own docker-launched run. Zero VRAM means
    # it holds no memory and cannot perturb a timing, so it is not contention —
    # this is exactly what a container being torn down looks like.
    case "$mem" in *"'value': 0,"*|0|0B|"0 B"|"?") continue ;; esac
    is_ours "$p" || echo "gpu$g:$p ($mem)"
  done
}

# ---- FIFO ticket queue. A ticket is "<seq>.<pid>" holding "want since start label"; it
# is live while that pid runs with the recorded start time (pid reuse cannot revive it).
QDIR="$LEASE_DIR/queue"
mkdir -p "$QDIR" 2>/dev/null && chmod 1777 "$QDIR" 2>/dev/null
proc_start() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }
live_tickets() {
  local t pid start
  for t in "$QDIR"/*.*; do
    [ -e "$t" ] || continue
    pid=${t##*.}
    start=$(awk '{print $3}' "$t" 2>/dev/null)
    if [ -n "$start" ] && [ "$(proc_start "$pid")" = "$start" ]; then echo "$t"
    else rm -f "$t" 2>/dev/null; fi
  done
}

if [ "$1" = "--audit" ]; then
  f=$(foreign); [ -n "$f" ] && { echo "FOREIGN GPU PROCS:"; echo "$f"; } || echo "GPU: no foreign compute procs"
  exit 0
fi
if [ "$1" = "--status" ]; then
  echo "vendor=$VENDOR gpus=$NGPU lease-dir=$LEASE_DIR"
  for ((i = 0; i < NGPU; i++)); do
    f="$LEASE_DIR/gpu.$i.lease"; [ -e "$f" ] || : >"$f" 2>/dev/null
    if flock -n "$f" true 2>/dev/null; then echo "  gpu$i: free"; else echo "  gpu$i: HELD"; fi
  done
  echo "--- queue (oldest first) ---"
  for t in $(live_tickets); do
    read -r w since _ label <"$t" 2>/dev/null || continue
    echo "  pid=${t##*.} want=$w waited=$(( $(date +%s) - since ))s $label"
  done
  echo "--- recent ---"; tail -20 "$LOG" 2>/dev/null
  case "$VENDOR" in
    nvidia) nvidia-smi --query-gpu=memory.used,memory.total,utilization.gpu --format=csv,noheader ;;
    amd)    rocm-smi --showmeminfo vram --csv 2>/dev/null | grep -i "^card" ;;
  esac
  f=$(foreign); [ -n "$f" ] && { echo "--- foreign procs ---"; echo "$f"; }
  exit 0
fi

WANT=0
while :; do
  case "$1" in
    -n) WANT="${2:?-n needs a count}"; shift 2 ;;
    --max-hold) MAX_HOLD="${2:?--max-hold needs seconds}"; shift 2 ;;
    *) break ;;
  esac
done
LABEL="${1:?usage: gpulease [-n k] [--max-hold s] <label> <command...>}"; shift
[ "$#" -ge 1 ] || { echo "gpulease: no command for '$LABEL' (holders: gpulease --status)" >&2; exit 2; }
[ "$WANT" -eq 0 ] && WANT=$NGPU                       # default: the whole box
[ "$WANT" -gt "$NGPU" ] && { echo "gpulease: asked $WANT gpus, box has $NGPU" >&2; exit 2; }

# Acquire WANT free cards. Scan low->high, non-blocking; retry until TIMEOUT.
# Each held card keeps an open fd (FD_BASE+) so the lock lives for the whole run
# and is released by the kernel when this shell exits, even on kill.
# FD_BASE is high on purpose: bash reserves low fds (10 in particular is already
# taken under some harnesses, and flock on it fails), which silently cost us
# gpu0 on every acquire.
FD_BASE=200
GOT=""; NGOT=0; FD=$FD_BASE
release_all() {
  local fd
  for fd in $(seq $FD_BASE $((FD - 1))); do eval "exec $fd>&-" 2>/dev/null; done
  GOT=""; NGOT=0; FD=$FD_BASE
}
try_acquire() {
  local i f
  for ((i = 0; i < NGPU; i++)); do
    [ "$NGOT" -ge "$WANT" ] && break
    f="$LEASE_DIR/gpu.$i.lease"
    [ -e "$f" ] || : >"$f" 2>/dev/null || continue
    # The lease directory is shared across users. Existing lock files may be readable but
    # not writable by this user; flock only needs an open descriptor, so open read-only.
    eval "exec $FD<\"$f\"" 2>/dev/null || continue
    if flock -n "$FD" 2>/dev/null; then
      GOT="${GOT:+$GOT }$i"; NGOT=$((NGOT + 1)); FD=$((FD + 1))
    else
      eval "exec $FD>&-" 2>/dev/null
    fi
  done
  [ "$NGOT" -ge "$WANT" ]
}

free_cards() {
  local i f n=0
  for ((i = 0; i < NGPU; i++)); do
    f="$LEASE_DIR/gpu.$i.lease"
    [ -e "$f" ] || : >"$f" 2>/dev/null || continue
    flock -n "$f" true 2>/dev/null && n=$((n + 1))
  done
  echo "$n"
}
# Cards claimed by live tickets older than ours: we may only take what is left over.
older_want() {
  local t w sum=0
  for t in $(live_tickets); do
    [ "$t" = "$TICKET" ] && break
    read -r w _ <"$t" 2>/dev/null && sum=$((sum + w))
  done
  echo "$sum"
}

S=$(date +%s)
: >>"$LEASE_DIR/queue.seq" 2>/dev/null; chmod 666 "$LEASE_DIR/queue.seq" 2>/dev/null
exec 199<"$LEASE_DIR/queue.seq" && flock 199
SEQ=$(( $(cat "$LEASE_DIR/queue.seq" 2>/dev/null || echo 0) + 1 ))
echo "$SEQ" >"$LEASE_DIR/queue.seq"
TICKET="$QDIR/$(printf %012d "$SEQ").$$"
echo "$WANT $S $(proc_start $$) $LABEL" >"$TICKET"
exec 199<&-
trap 'rm -f "$TICKET"' EXIT
until [ $(( $(free_cards) - $(older_want) )) -ge "$WANT" ] && try_acquire; do
  release_all                                          # avoid deadlocking peers
  if [ $(( $(date +%s) - S )) -ge "$TIMEOUT" ]; then
    echo "[$(date -Is)] $LABEL TIMEOUT after ${TIMEOUT}s (wanted $WANT of $NGPU)" | tee -a "$LOG" >&2
    exit 75
  fi
  sleep 1
done
rm -f "$TICKET"
W=$(( $(date +%s) - S ))

# Pin the child to exactly the cards we hold. A partial lease that still saw
# every device would make the lease meaningless.
if [ "$NGOT" -lt "$NGPU" ]; then
  VIS=$(echo "$GOT" | tr ' ' ',')
  if [ "$VENDOR" = amd ]; then
    # ROCr renumbers its filtered agents. Applying the original physical ids a
    # second time through HIP/CUDA_VISIBLE_DEVICES can therefore hide every
    # device when a partial lease starts above gpu0.
    export ROCR_VISIBLE_DEVICES="$VIS"
    unset HIP_VISIBLE_DEVICES CUDA_VISIBLE_DEVICES
  else
    export CUDA_VISIBLE_DEVICES="$VIS"
  fi
fi

PRE=$(foreign "$GOT")
CONTENDED=0
if [ -n "$PRE" ]; then
  CONTENDED=1
  echo "[$(date -Is)] $LABEL WARN foreign-before: $(echo $PRE|tr '\n' ' ')" | tee -a "$LOG" >&2
  echo "*** GPU CONTENDED AT START — TIMINGS FROM THIS RUN ARE NOT TRUSTWORTHY ***" >&2
fi
echo "[$(date -Is)] $LABEL ACQUIRED gpus=[$GOT] (waited ${W}s) pid=$$" >> "$LOG"

# Own process group (job control), so the whole job tree stops with the lease: a killed
# lease used to leave its servers on the card with no lease at all.
set -m
"$@" &
CHILD=$!
set +m
stop_child() {
  local i
  kill -TERM -- "-$CHILD" 2>/dev/null || return 0
  for i in $(seq 1 20); do kill -0 -- "-$CHILD" 2>/dev/null || return 0; sleep 0.5; done
  kill -KILL -- "-$CHILD" 2>/dev/null
}
STOPPED=""
trap 'STOPPED=signal; stop_child' TERM INT HUP
T0=$(date +%s)
while kill -0 "$CHILD" 2>/dev/null; do
  sleep 2
  if [ -z "$STOPPED" ] && [ "$MAX_HOLD" -gt 0 ] && [ $(( $(date +%s) - T0 )) -ge "$MAX_HOLD" ] &&
     [ -n "$(live_tickets)" ]; then
    STOPPED=preempt
    echo "[$(date -Is)] $LABEL PREEMPTED after ${MAX_HOLD}s with waiters queued" | tee -a "$LOG" >&2
    stop_child
  fi
done
wait "$CHILD"; RC=$?
stop_child                                             # strays the command left behind
[ "$STOPPED" = preempt ] && RC=124

POST=$(foreign "$GOT")
if [ -n "$POST" ]; then
  CONTENDED=1
  echo "[$(date -Is)] $LABEL WARN foreign-during: $(echo $POST|tr '\n' ' ')" | tee -a "$LOG" >&2
  echo "*** GPU WAS CONTENDED — RE-RUN THIS MEASUREMENT ***" >&2
fi
[ "$CONTENDED" -eq 0 ] || RC=$([ $RC -eq 0 ] && echo 76 || echo $RC)
echo "[$(date -Is)] $LABEL RELEASED gpus=[$GOT] rc=$RC held=$(( $(date +%s) - S - W ))s" >> "$LOG"
exit $RC
