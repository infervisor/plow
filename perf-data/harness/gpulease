#!/usr/bin/env bash
# Serialize GPU access across concurrent agents on the single RTX 5090.
#   gpulease <label> <command...>    run holding the exclusive lease
#   gpulease --status                holder + queue + VRAM
#   gpulease --audit                 list foreign GPU processes right now
# NOTE: the lease is ADVISORY (flock). It cannot stop a process that never calls
# it. So we also AUDIT for foreign compute processes before/after and WARN loudly,
# because a contended run silently invalidates every timing number.
LOCK=/workspace/gpu/.lease
LOG=/workspace/gpu/lease.log
TIMEOUT=${GPU_LEASE_TIMEOUT:-1800}

# Can we even ATTRIBUTE a GPU pid? nvidia-smi reports HOST pids; inside a PID
# namespace (container) none of them resolve in our /proc, so every process —
# including our own child — looks "foreign" and the audit is pure noise. Detect
# that once and degrade to lock-only rather than reporting false contention.
# Returns 0 (attributable) only if at least one reported pid exists for us.
pid_ns_ok() {
  local pids p
  pids=$(nvidia-smi --query-compute-apps=pid --format=csv,noheader 2>/dev/null | tr -d ' ')
  [ -z "$pids" ] && return 0          # nothing on the GPU: nothing to misattribute
  for p in $pids; do [ -e "/proc/$p" ] && return 0; done
  return 1
}

# 0 if $1 is this lease shell or ANY descendant of it. The leased command is
# exec'd as a child, so comparing against $$ alone (what this used to do) made
# every leased run report its own CUDA process as foreign — which forced RC to
# 76 on success, so rc=76 carried no contention information at all.
is_ours() {
  local p="$1" i=0
  while [ -n "$p" ] && [ "$p" != "0" ] && [ "$i" -lt 64 ]; do
    [ "$p" = "$$" ] && return 0
    p=$(awk '/^PPid:/{print $2}' "/proc/$p/status" 2>/dev/null)
    i=$((i + 1))
  done
  return 1
}

foreign() {  # pids using the GPU that are not us or our descendants
  pid_ns_ok || return 0              # namespaced: cannot attribute, report nothing
  nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader 2>/dev/null |
    while IFS=, read -r p mem; do
      p=$(echo "$p" | tr -d ' ')
      [ -z "$p" ] && continue
      is_ours "$p" || echo "$p ($mem)"
    done
}

if [ "$1" = "--audit" ]; then f=$(foreign); [ -n "$f" ] && { echo "FOREIGN GPU PROCS:"; echo "$f"; } || echo "GPU: no foreign compute procs"; exit 0; fi
if [ "$1" = "--status" ]; then
  if flock -n "$LOCK" true 2>/dev/null; then echo "GPU: free"; else echo "GPU: held"; fi
  echo "--- recent ---"; tail -20 "$LOG" 2>/dev/null
  nvidia-smi --query-gpu=memory.used,memory.total,utilization.gpu --format=csv,noheader
  f=$(foreign); [ -n "$f" ] && { echo "--- foreign procs ---"; echo "$f"; }
  exit 0
fi

LABEL="${1:?usage: gpulease <label> <command...>}"; shift
touch "$LOCK"; exec 9>"$LOCK"
S=$(date +%s)
if ! flock -w "$TIMEOUT" 9; then
  echo "[$(date -Is)] $LABEL TIMEOUT after ${TIMEOUT}s" | tee -a "$LOG" >&2; exit 75
fi
W=$(( $(date +%s) - S ))

PRE=$(foreign)
if [ -n "$PRE" ]; then
  echo "[$(date -Is)] $LABEL WARN foreign-before: $(echo $PRE|tr '\n' ' ')" | tee -a "$LOG" >&2
  echo "*** GPU CONTENDED AT START — TIMINGS FROM THIS RUN ARE NOT TRUSTWORTHY ***" >&2
fi
echo "[$(date -Is)] $LABEL ACQUIRED (waited ${W}s) pid=$$" >> "$LOG"

"$@"; RC=$?

POST=$(foreign)
if [ -n "$POST" ]; then
  echo "[$(date -Is)] $LABEL WARN foreign-during: $(echo $POST|tr '\n' ' ')" | tee -a "$LOG" >&2
  echo "*** GPU WAS CONTENDED — RE-RUN THIS MEASUREMENT ***" >&2
  RC=$([ $RC -eq 0 ] && echo 76 || echo $RC)   # 76 = completed but contended
fi
echo "[$(date -Is)] $LABEL RELEASED rc=$RC held=$(( $(date +%s) - S - W ))s" >> "$LOG"
exit $RC
